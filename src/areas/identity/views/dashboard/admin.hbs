<!-- Modal: Admin Ban Food Product -->
<div
  id="adminBanProductModal"
  class="!m-0 fixed inset-0 z-[100] bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4 hidden"
  onclick="if (event.target === this) closeAdminBanModal()"
>
  <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full max-h-[90vh] flex flex-col border border-slate-200 overflow-hidden transform transition-all">
    <div class="p-5 sm:p-6 border-b border-slate-100 flex items-center justify-between bg-rose-50/50 shrink-0">
      <div class="flex items-center gap-2.5">
        <span class="w-7 h-7 rounded-lg bg-rose-700 text-white flex items-center justify-center text-xs font-bold">!</span>
        <div>
          <h3 class="text-base font-bold text-slate-900">Ban food product from website</h3>
          <p class="text-xs text-slate-500">Regulatory quarantine & safety alert advisory</p>
        </div>
      </div>
      <button
        type="button"
        onclick="closeAdminBanModal()"
        class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg min-w-[36px] min-h-[36px] flex items-center justify-center"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="adminBanProductForm" method="POST" action="" class="p-5 sm:p-6 space-y-4 overflow-y-auto flex-grow">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">

      <p class="text-xs text-slate-600">
        You are executing a regulatory ban on: <strong id="adminBanProductName" class="text-slate-900"></strong> (Barcode: <span id="adminBanProductBarcode" class="font-mono font-semibold text-slate-800"></span>).
      </p>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">
          Mandatory regulatory violation / ban reason <span class="text-rose-600">*</span>
        </label>
        <textarea
          name="reason"
          required
          rows="4"
          placeholder="Specify laboratory finding, undeclared allergen, toxic additive, counterfeit report reference, or statutory recall directive..."
          class="w-full text-xs rounded-lg border border-slate-300 p-3 bg-white text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-700"
        ></textarea>
        <p class="text-[11px] text-slate-400 mt-1">Minimum 5 characters. Displayed publicly on the regulatory safety docket.</p>
      </div>

      <div class="pt-2 flex items-center justify-end gap-2.5">
        <button
          type="button"
          onclick="closeAdminBanModal()"
          class="px-4 py-2 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-lg text-xs font-semibold transition-colors"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="px-4 py-2 bg-rose-700 hover:bg-rose-800 text-white rounded-lg text-xs font-semibold transition-colors shadow-sm"
        >
          Confirm regulatory ban
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Admin Permanent Product Deletion -->
<div
  id="adminDeleteProductModal"
  class="!m-0 fixed inset-0 z-[100] bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4 hidden"
  onclick="if (event.target === this) closeAdminDeleteModal()"
>
  <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full max-h-[90vh] flex flex-col border border-slate-200 overflow-hidden transform transition-all">
    <div class="p-5 sm:p-6 border-b border-slate-100 flex items-center justify-between bg-rose-50/50 shrink-0">
      <div class="flex items-center gap-2.5">
        <span class="w-7 h-7 rounded-lg bg-rose-700 text-white flex items-center justify-center text-xs font-bold">&times;</span>
        <div>
          <h3 class="text-base font-bold text-slate-900">Permanently delete food formulation</h3>
          <p class="text-xs text-rose-600 font-semibold">Irreversible administrative purge</p>
        </div>
      </div>
      <button
        type="button"
        onclick="closeAdminDeleteModal()"
        class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg min-w-[36px] min-h-[36px] flex items-center justify-center"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="adminDeleteProductForm" method="POST" action="" class="p-5 sm:p-6 space-y-4 overflow-y-auto flex-grow">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">

      <p class="text-xs text-slate-600 leading-relaxed">
        You are about to permanently delete <strong id="adminDeleteProductName" class="text-slate-900"></strong>. This deletes all declared ingredients, nutrition facts, and associated records.
      </p>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">
          Type the barcode <strong id="adminDeleteProductBarcodeLabel" class="font-mono text-slate-900"></strong> to confirm:
        </label>
        <input
          type="text"
          id="adminConfirmDeleteInput"
          oninput="checkAdminDeleteInput()"
          placeholder="Enter barcode exactly"
          class="w-full text-xs rounded-lg border border-slate-300 px-3 py-2 bg-white text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-700 font-mono"
        />
      </div>

      <div class="pt-2 flex items-center justify-end gap-2.5">
        <button
          type="button"
          onclick="closeAdminDeleteModal()"
          class="px-4 py-2 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-lg text-xs font-semibold transition-colors"
        >
          Cancel
        </button>
        <button
          type="submit"
          id="adminConfirmDeleteBtn"
          disabled
          class="px-4 py-2 bg-rose-700 hover:bg-rose-800 disabled:opacity-40 disabled:cursor-not-allowed text-white rounded-lg text-xs font-semibold transition-colors shadow-sm"
        >
          Delete permanently
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Control Scripts -->
<script>
  function openAddUserModal() {
    var modal = document.getElementById('addUserModal');
    if (modal) modal.classList.remove('hidden');
  }

  function closeAddUserModal() {
    var modal = document.getElementById('addUserModal');
    if (modal) modal.classList.add('hidden');
  }

  function openEditUserModal(btn) {
    var id = btn.getAttribute('data-id');
    var name = btn.getAttribute('data-name');
    var email = btn.getAttribute('data-email');
    var role = btn.getAttribute('data-role');
    var verified = btn.getAttribute('data-verified') === 'true';

    var form = document.getElementById('editUserForm');
    if (form) form.action = '/dashboard/admin/users/' + id + '/update';

    var idDisplay = document.getElementById('editUserIdDisplay');
    if (idDisplay) idDisplay.textContent = '#' + id;

    var nameInput = document.getElementById('editUserName');
    if (nameInput) nameInput.value = name || '';

    var emailInput = document.getElementById('editUserEmail');
    if (emailInput) emailInput.value = email || '';

    var roleSelect = document.getElementById('editUserRole');
    if (roleSelect) roleSelect.value = role || 'consumer';

    var verifiedCheckbox = document.getElementById('editUserVerified');
    if (verifiedCheckbox) verifiedCheckbox.checked = verified;

    var pwdInput = document.getElementById('editUserPassword');
    if (pwdInput) pwdInput.value = '';

    var modal = document.getElementById('editUserModal');
    if (modal) modal.classList.remove('hidden');
  }

  function closeEditUserModal() {
    var modal = document.getElementById('editUserModal');
    if (modal) modal.classList.add('hidden');
  }

  // Admin Catalog Governance Modal Handlers
  function openAdminBanModal(id, name, barcode) {
    var form = document.getElementById('adminBanProductForm');
    if (form) form.action = '/catalog/manage/' + id + '/ban';
    var nameEl = document.getElementById('adminBanProductName');
    if (nameEl) nameEl.textContent = name;
    var barcodeEl = document.getElementById('adminBanProductBarcode');
    if (barcodeEl) barcodeEl.textContent = barcode;
    var modal = document.getElementById('adminBanProductModal');
    if (modal) modal.classList.remove('hidden');
  }

  function closeAdminBanModal() {
    var modal = document.getElementById('adminBanProductModal');
    if (modal) modal.classList.add('hidden');
  }

  var currentDeleteBarcode = '';
  function openAdminDeleteModal(id, name, barcode) {
    currentDeleteBarcode = barcode;
    var form = document.getElementById('adminDeleteProductForm');
    if (form) form.action = '/catalog/manage/' + id + '/delete';
    var nameEl = document.getElementById('adminDeleteProductName');
    if (nameEl) nameEl.textContent = name;
    var barcodeEl = document.getElementById('adminDeleteProductBarcodeLabel');
    if (barcodeEl) barcodeEl.textContent = barcode;
    var inputEl = document.getElementById('adminConfirmDeleteInput');
    if (inputEl) inputEl.value = '';
    var btn = document.getElementById('adminConfirmDeleteBtn');
    if (btn) btn.disabled = true;
    var modal = document.getElementById('adminDeleteProductModal');
    if (modal) modal.classList.remove('hidden');
  }

  function closeAdminDeleteModal() {
    var modal = document.getElementById('adminDeleteProductModal');
    if (modal) modal.classList.add('hidden');
  }

  function checkAdminDeleteInput() {
    var input = document.getElementById('adminConfirmDeleteInput');
    var btn = document.getElementById('adminConfirmDeleteBtn');
    if (input && btn) {
      btn.disabled = (input.value.trim() !== currentDeleteBarcode);
    }
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeAddUserModal();
      closeEditUserModal();
      closeAdminBanModal();
      closeAdminDeleteModal();
    }
  });
</script>
