<div class="clinical-card group bg-white dark:bg-[#141413] border border-slate-200 dark:border-white/10 rounded-xl p-5 flex flex-col justify-between">
  <div>
    <!-- Category & Score Header -->
    <div class="flex items-start justify-between gap-2 mb-2.5">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 inline-flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-slate-400 dark:bg-slate-500"></span>
        {{this.category}}
      </span>
      
      <div class="flex items-center gap-1.5">
        {{#if (eq this.status 'banned')}}
          <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-rose-600 text-white">
            Banned
          </span>
        {{/if}}
        {{#if (or this.userConflict.hasAllergenConflict this.conflict.hasAllergenConflict)}}
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-rose-50 text-rose-800 border border-rose-200 dark:bg-rose-950/60 dark:text-rose-300 dark:border-rose-800">
            Allergen alert
          </span>
        {{else}}
          {{#if (or this.conflict.hasDietaryConflict false)}}
            <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-200 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800">
              Dietary alert
            </span>
          {{else}}
            {{#if (or (and this.userConflict.isSafeForUser this.userConflict.profileConfigured) (eq this.conflict.isSafe true))}}
              <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800">
                Safe
              </span>
            {{/if}}
          {{/if}}
        {{/if}}
        
        <span class="score-badge px-2.5 py-0.5 text-xs font-bold font-mono {{#if (gte this.qualityScore 80)}}score-badge-high{{else}}{{#if (gte this.qualityScore 60)}}score-badge-mid{{else}}score-badge-low{{/if}}{{/if}}">
          {{this.qualityScore}} / 100
        </span>
      </div>
    </div>

    <!-- Brand & Food Name -->
    <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">{{this.brand}}</div>
    <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 tracking-tight leading-snug mt-0.5">
      <a href="/catalog/product/{{this.id}}" class="hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors">
        {{this.name}}
      </a>
    </h3>

    <!-- Barcode & Serving -->
    <div class="text-xs text-slate-400 dark:text-slate-500 mt-1 font-mono">
      Barcode: {{this.barcode}}{{#if this.servingSize}} · {{this.servingSize}}{{this.servingUnit}}{{/if}}
    </div>

    <!-- Dietary Tags -->
    {{#if this.dietaryTags.length}}
      <div class="flex flex-wrap gap-1.5 mt-3">
        {{#each this.dietaryTags}}
          <span class="text-[11px] font-medium px-2 py-0.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-md border border-slate-200/60 dark:border-slate-700/60">
            {{this}}
          </span>
        {{/each}}
      </div>
    {{/if}}

    <!-- Declared Ingredients Snippet with HUD Micro-Inspector attributes -->
    {{#if this.ingredients.length}}
      <div class="mt-3.5 pt-3 border-t border-slate-100 dark:border-white/5 text-xs text-slate-600 dark:text-slate-300 line-clamp-2">
        <span class="font-semibold text-slate-800 dark:text-slate-200">Ingredients:</span>
        {{#each this.ingredients}}
          <span
            data-inspectable-ingredient
            data-ingredient-name="{{this.name}}"
            data-hazard="{{#if this.isAllergen}}hazard{{else}}safe{{/if}}"
            data-allergen="{{#if this.isAllergen}}Allergen Alert{{else}}false{{/if}}"
            class="cursor-help transition-colors {{#if this.isAllergen}}text-rose-700 dark:text-rose-400 font-semibold underline decoration-rose-300 dark:decoration-rose-700{{else}}hover:text-emerald-700 dark:hover:text-emerald-400{{/if}}"
          >{{this.name}}{{#unless @last}}, {{/unless}}</span>
        {{/each}}
      </div>
    {{/if}}
  </div>

  <!-- Card Action with A90-style Diagonal Arrow -->
  <div class="mt-4 pt-3 border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
    <a
      href="/catalog/product/{{this.id}}"
      class="text-xs font-bold text-slate-900 dark:text-slate-100 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors inline-flex items-center gap-1 group-hover:underline"
    >
      <span>Inspect food details</span>
      <span class="link-diagonal-arrow font-mono" aria-hidden="true">↗</span>
    </a>
    {{#if this.nutritionFacts.length}}
      <span class="nutrient-well px-2 py-0.5 text-[10px] font-mono font-bold text-slate-500 dark:text-slate-400">
        {{this.nutritionFacts.length}} facts
      </span>
    {{/if}}
  </div>
</div>
