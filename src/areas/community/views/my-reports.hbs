<!-- Feature F13: Consumer Personal Food Complaint Tracker -->
<div class="max-w-5xl mx-auto space-y-6 pb-12">

  <!-- Header -->
  <div class="bg-white border border-slate-200 rounded-xl p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-slate-950 tracking-tight">My food safety reports</h1>
      <p class="text-sm text-slate-600 mt-1 max-w-2xl">
        Track the status of your private product complaints. Only you and authorized food-safety inspectors can view these records and attached photos.
      </p>
    </div>
    <a href="/catalog" class="px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-xs font-semibold transition-colors self-start sm:self-auto">
      Find a product to report
    </a>
  </div>

  <!-- Confirmation Banner with Reference Number -->
  {{#if submittedRef}}
    <div class="bg-emerald-50 border-2 border-emerald-300 rounded-xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div>
        <div class="text-sm font-bold text-emerald-950">Complaint submitted for inspector review</div>
        <p class="text-xs text-emerald-800 mt-1">
          Keep your reference number below to follow investigation updates.
        </p>
      </div>
      <div class="px-3.5 py-2 bg-white border border-emerald-300 rounded-lg font-mono text-sm font-black text-emerald-900">
        {{submittedRef}}
      </div>
    </div>
  {{/if}}

  <!-- Reports Ledger -->
  {{#if reports.length}}
    <div class="bg-white border border-slate-200 rounded-xl divide-y divide-slate-200 overflow-hidden">
      {{#each reports}}
        <article class="p-6 space-y-3">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2.5">
                <span class="font-mono text-xs font-bold px-2.5 py-0.5 rounded bg-slate-100 text-slate-800 border border-slate-200">
                  {{this.referenceNumber}}
                </span>
                <span class="text-xs font-semibold text-rose-800 bg-rose-50 border border-rose-200 px-2.5 py-0.5 rounded">
                  {{this.categoryLabel}}
                </span>
                <span class="text-xs text-slate-500">Submitted {{this.submittedOn}}</span>
              </div>
              <h2 class="text-base font-bold text-slate-950">
                <a href="/catalog/product/{{this.productId}}" class="hover:text-emerald-700 transition-colors">
                  {{this.product.name}}
                </a>
                {{#if this.product.brand}}
                  <span class="font-normal text-slate-500 text-sm">({{this.product.brand}})</span>
                {{/if}}
              </h2>
            </div>

            <!-- Status Pill -->
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold border {{#if (eq this.status 'resolved')}}bg-emerald-50 text-emerald-800 border-emerald-200{{else}}{{#if (eq this.status 'investigating')}}bg-blue-50 text-blue-800 border-blue-200{{else}}{{#if (eq this.status 'dismissed')}}bg-slate-100 text-slate-600 border-slate-200{{else}}bg-amber-50 text-amber-800 border-amber-200{{/if}}{{/if}}{{/if}}">
              {{this.statusLabel}}
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs bg-slate-50 border border-slate-100 rounded-lg p-3">
            <div>
              <span class="text-slate-500">Batch code:</span>
              <span class="font-mono font-semibold text-slate-900 ml-1">
                {{#if this.batchCode}}{{this.batchCode}}{{else}}Not provided{{/if}}
              </span>
            </div>
            <div>
              <span class="text-slate-500">Purchase location:</span>
              <span class="font-semibold text-slate-900 ml-1">{{this.purchasePlace}}</span>
            </div>
          </div>

          <p class="text-sm text-slate-700 whitespace-pre-wrap leading-relaxed max-w-[75ch]">{{this.description}}</p>

          {{#if this.evidence.length}}
            <div class="pt-1">
              <a
                href="/community/reports/{{this.id}}/evidence"
                target="_blank"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-800 hover:text-emerald-700 underline"
              >
                Open attached private photo evidence
              </a>
            </div>
          {{/if}}
        </article>
      {{/each}}
    </div>
  {{else}}
    <div class="bg-white border border-slate-200 rounded-xl p-10 text-center space-y-3">
      <h2 class="text-base font-bold text-slate-900">No complaints submitted yet</h2>
      <p class="text-sm text-slate-500 max-w-md mx-auto">
        If you encounter a spoiled, damaged, mislabelled, or suspected counterfeit packaged food, open its product page in the catalog to file a private report.
      </p>
      <a href="/catalog" class="inline-block px-4 py-2 bg-slate-900 text-white rounded-lg text-xs font-semibold hover:bg-slate-800 transition-colors">
        Browse food catalog
      </a>
    </div>
  {{/if}}
</div>
