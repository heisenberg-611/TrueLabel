<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
  <!-- Header: Official Regulatory Audit Docket -->
  <div class="bg-white border border-slate-200 rounded-xl p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-900 border border-amber-200">
          Official statutory auditor
        </span>
        <span class="text-xs font-mono text-slate-500">Badge #{{user.id}}</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">{{user.name}}</h1>
      <p class="text-sm text-slate-500 max-w-2xl">
        Statutory compliance audit bench. Review manufacturer safety certifications, verify government trade licences, and issue binding food safety decisions.
      </p>
    </div>
    
    <div class="flex flex-wrap items-center gap-2.5">
      <a
        href="/safety/licence/verify"
        class="px-4 py-2.5 bg-amber-700 hover:bg-amber-800 text-white rounded-lg text-xs font-semibold transition-colors flex items-center gap-2 shadow-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        Verify licence registry
      </a>
      <a
        href="/community/reports/queue"
        class="px-4 py-2.5 bg-rose-700 hover:bg-rose-800 text-white rounded-lg text-xs font-semibold transition-colors shadow-sm"
      >
        Complaint queue ({{complaintStats.pending}} pending)
      </a>
      <a
        href="/safety/documents"
        class="px-4 py-2.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-semibold transition-colors"
      >
        Document archive
      </a>
    </div>
  </div>

  <!-- Connected Telemetry Bar (No floating cards) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 bg-white border border-slate-200 rounded-xl divide-y sm:divide-y-0 sm:divide-x divide-slate-100 overflow-hidden shadow-sm">
    <div class="p-5">
      <span class="text-xs font-medium text-slate-500 block">Pending audit queue</span>
      <div class="text-2xl sm:text-3xl font-black text-amber-800 font-mono mt-1">{{stats.pending}}</div>
      <span class="text-[11px] text-slate-400 block mt-0.5">Awaiting inspection</span>
    </div>
    <div class="p-5">
      <span class="text-xs font-medium text-slate-500 block">Accreditations approved</span>
      <div class="text-2xl sm:text-3xl font-black text-emerald-800 font-mono mt-1">{{stats.approved}}</div>
      <span class="text-[11px] text-slate-400 block mt-0.5">Statutory standard verified</span>
    </div>
    <div class="p-5">
      <span class="text-xs font-medium text-slate-500 block">Rejected submissions</span>
      <div class="text-2xl sm:text-3xl font-black text-rose-800 font-mono mt-1">{{stats.rejected}}</div>
      <span class="text-[11px] text-slate-400 block mt-0.5">With deficiency reasons</span>
    </div>
    <div class="p-5">
      <span class="text-xs font-medium text-slate-500 block">Expiring in 30 days</span>
      <div class="text-2xl sm:text-3xl font-black text-slate-800 font-mono mt-1">{{stats.expiringSoon}}</div>
      <span class="text-[11px] text-slate-400 block mt-0.5">Renewal required</span>
    </div>
  </div>

  <!-- Pending Review Queue Table -->
  <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
    <div class="p-6 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <span>Active document review queue</span>
          <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200 font-mono">{{pendingDocuments.length}}</span>
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">Inspect submitted laboratory reports, ISO/HACCP certificates, and record audit decisions</p>
      </div>
    </div>

    {{#if pendingDocuments.length}}
      <div class="overflow-x-auto">
        <table class="w-full min-w-[700px] text-left text-xs">
          <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold text-[11px]">
            <tr>
              <th class="px-6 py-3.5">Company and certificate</th>
              <th class="px-6 py-3.5">Certificate number</th>
              <th class="px-6 py-3.5">Validity period</th>
              <th class="px-6 py-3.5">Laboratory file</th>
              <th class="px-6 py-3.5 text-right">Regulatory decision</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-normal">
            {{#each pendingDocuments}}
              <tr class="hover:bg-slate-50/60 transition-colors">
                <td class="px-6 py-4">
                  <div class="font-bold text-slate-900 text-sm">{{this.companyName}}</div>
                  <div class="text-xs text-slate-500 mt-0.5 font-medium">{{this.formattedType}}</div>
                </td>
                <td class="px-6 py-4">
                  <div class="font-mono font-bold text-slate-800">{{this.certificateNumber}}</div>
                  <div class="text-xs text-slate-400 mt-0.5">{{this.issuer}}</div>
                </td>
                <td class="px-6 py-4 font-mono text-slate-600">
                  {{this.issueDate}} to {{this.expiryDate}}
                </td>
                <td class="px-6 py-4">
                  {{#if this.fileUrl}}
                    <a href="{{this.fileUrl}}" target="_blank" class="text-slate-700 hover:text-slate-900 font-semibold underline inline-flex items-center gap-1">
                      Inspect file
                    </a>
                  {{else}}
                    <span class="text-slate-400">No file attached</span>
                  {{/if}}
                </td>
                <td class="px-6 py-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <form action="/safety/documents/{{this.id}}/review" method="POST" class="inline">
                      <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                      <input type="hidden" name="action" value="approve">
                      <input type="hidden" name="notes" value="Verified and approved by official food safety inspector.">
                      <button type="submit" class="px-3 py-1.5 bg-emerald-700 text-white rounded-md text-xs font-semibold hover:bg-emerald-800 transition-colors">
                        Approve
                      </button>
                    </form>
                    <form action="/safety/documents/{{this.id}}/review" method="POST" class="inline">
                      <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                      <input type="hidden" name="action" value="reject">
                      <input type="hidden" name="rejectionReason" value="Document incomplete or does not meet statutory hygiene parameters.">
                      <button type="submit" class="px-3 py-1.5 border border-rose-300 text-rose-700 rounded-md text-xs font-semibold hover:bg-rose-50 transition-colors">
                        Reject
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="p-12 text-center text-slate-500">
        <p class="font-bold text-sm text-slate-900">Review queue cleared</p>
        <p class="text-xs text-slate-500 mt-1">All manufacturer food safety documents and accreditations have been audited.</p>
      </div>
    {{/if}}
  </div>

  <!-- Feature F13: Open Food Safety Complaints Docket Preview -->
  <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
    <div class="p-6 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <span>Active food complaint queue (F13)</span>
          <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200 font-mono">{{complaintStats.pending}} pending</span>
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">Consumer reports of counterfeit, spoiled, contaminated, damaged, or mislabelled food items</p>
      </div>
      <a href="/community/reports/queue" class="text-xs font-semibold text-slate-800 hover:text-emerald-700 underline">
        Open full complaint docket
      </a>
    </div>

    {{#if openComplaints.length}}
      <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] text-left text-xs">
          <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold text-[11px]">
            <tr>
              <th class="px-6 py-3">Reference</th>
              <th class="px-6 py-3">Product &amp; batch</th>
              <th class="px-6 py-3">Category</th>
              <th class="px-6 py-3">Status</th>
              <th class="px-6 py-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {{#each openComplaints}}
              <tr class="hover:bg-slate-50/60">
                <td class="px-6 py-3.5 font-mono font-bold text-slate-900">{{this.referenceNumber}}</td>
                <td class="px-6 py-3.5">
                  <div class="font-bold text-slate-900">{{this.product.name}}</div>
                  <div class="font-mono text-[11px] text-slate-500">
                    Batch: {{#if this.batchCode}}{{this.batchCode}}{{else}}N/A{{/if}}
                    {{#if this.hasLinkedBatchCluster}}
                      <span class="ml-1.5 px-1.5 py-0.5 rounded bg-amber-50 border border-amber-300 text-amber-900 font-sans font-semibold">{{this.linkedCount}} linked</span>
                    {{/if}}
                  </div>
                </td>
                <td class="px-6 py-3.5">
                  <span class="px-2 py-0.5 rounded bg-rose-50 border border-rose-200 text-rose-900 font-semibold text-[11px]">{{this.categoryLabel}}</span>
                </td>
                <td class="px-6 py-3.5">
                  <span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-200">{{this.statusLabel}}</span>
                </td>
                <td class="px-6 py-3.5 text-right">
                  <a href="/community/reports/queue" class="font-semibold text-slate-800 hover:text-emerald-700 underline">Investigate</a>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="p-8 text-center text-xs text-slate-500">
        No open consumer food safety complaints pending review.
      </div>
    {{/if}}
  </div>

  <!-- Recent Inspector Decisions -->
  <div class="bg-white border border-slate-200 rounded-xl p-6">
    <div class="pb-3 border-b border-slate-100 mb-4">
      <h2 class="text-base font-bold text-slate-900">Recent audit decisions</h2>
      <p class="text-xs text-slate-500 mt-0.5">Official compliance trail with recorded inspector notes</p>
    </div>
    <div class="space-y-3">
      {{#each recentDecisions}}
        <div class="p-4 rounded-lg border border-slate-100 bg-slate-50/70 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
          <div>
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-900">{{this.companyName}}</span>
              <span class="font-mono text-slate-500 text-[11px]">({{this.formattedType}})</span>
              <span class="px-2 py-0.5 rounded text-[11px] font-semibold {{#if (eq this.status 'approved')}}bg-emerald-50 text-emerald-800 border border-emerald-200{{else}}bg-rose-50 text-rose-800 border border-rose-200{{/if}}">
                {{this.status}}
              </span>
            </div>
            <div class="text-slate-600 mt-1 font-normal">
              {{#if this.rejectionReason}}
                <span class="text-rose-700 font-medium">Deficiency: {{this.rejectionReason}}</span>
              {{else}}
                <span>{{this.notes}}</span>
              {{/if}}
            </div>
          </div>
          <div class="text-right font-mono text-slate-400 text-[11px] flex-shrink-0">
            Auditor: {{this.reviewedByName}}
          </div>
        </div>
      {{/each}}
    </div>
  </div>
</div>
