<section class="max-w-xl mx-auto my-12 sm:my-20">
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="p-6 sm:p-9 space-y-6">
      <!-- Calm lock/access icon + Editorial headline -->
      <div class="flex items-start gap-4">
        <div class="w-11 h-11 rounded-xl bg-amber-50 text-amber-700 border border-amber-200 flex items-center justify-center shrink-0 mt-0.5">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
        </div>

        <div class="space-y-2 min-w-0">
          <h1 class="font-serif font-normal text-2xl sm:text-[28px] text-slate-950 leading-snug tracking-tight">
            {{#if heading}}
              {{heading}}
            {{else}}
              This section requires a different account
            {{/if}}
          </h1>
          <p class="text-sm sm:text-[15px] text-slate-600 leading-relaxed">
            {{#if message}}
              {{message}}
            {{else}}
              Your current account does not include access to this page.
            {{/if}}
          </p>
          {{#if hint}}
            <p class="text-xs sm:text-sm text-slate-500 leading-relaxed pt-1">
              {{hint}}
            </p>
          {{/if}}
        </div>
      </div>

      <!-- Helpful Next-Step Actions -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        {{#if primaryAction}}
          <a
            href="{{primaryAction.href}}"
            class="px-4 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg font-semibold text-sm transition-colors shadow-sm"
          >
            {{primaryAction.label}}
          </a>
        {{else}}
          <a
            href="/catalog"
            class="px-4 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg font-semibold text-sm transition-colors shadow-sm"
          >
            Explore food catalog
          </a>
        {{/if}}

        {{#if secondaryAction}}
          <a
            href="{{secondaryAction.href}}"
            class="px-4 py-2.5 border border-slate-300 text-slate-700 hover:bg-slate-100 rounded-lg font-semibold text-sm transition-colors"
          >
            {{secondaryAction.label}}
          </a>
        {{else}}
          <a
            href="/"
            class="px-4 py-2.5 border border-slate-300 text-slate-700 hover:bg-slate-100 rounded-lg font-semibold text-sm transition-colors"
          >
            Go home
          </a>
        {{/if}}
      </div>
    </div>

    {{#if user}}
      <div class="bg-slate-50 border-t border-slate-200 px-6 sm:px-9 py-4 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-600">
        <div>
          Signed in as <span class="font-semibold text-slate-900">{{user.name}}</span>
          {{#if currentRoleLabel}}
            <span class="text-slate-500">({{currentRoleLabel}})</span>
          {{/if}}
        </div>
        <form action="/auth/logout" method="POST" class="inline">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <button
            type="submit"
            class="font-semibold text-slate-700 hover:text-slate-950 underline underline-offset-2 transition-colors"
          >
            Sign out to switch accounts
          </button>
        </form>
      </div>
    {{/if}}
  </div>
</section>
