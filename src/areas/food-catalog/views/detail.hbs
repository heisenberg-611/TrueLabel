<div class="space-y-6">

  {{#if success}}
    <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-xs font-semibold text-emerald-900 flex items-center justify-between shadow-sm">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span>{{success}}</span>
      </div>
    </div>
  {{/if}}

  {{#if error}}
    <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-xs font-semibold text-rose-900 flex items-center justify-between shadow-sm">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        <span>{{error}}</span>
      </div>
    </div>
  {{/if}}

  <!-- Administrative Governance Action Ribbon (Admin Only) -->
  {{#if (eq user.role 'admin')}}
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 sm:p-5 text-slate-900 dark:text-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-sm">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-mono px-2.5 py-0.5 rounded bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 font-bold shadow-sm">Admin governance mode</span>
          <span class="text-xs font-mono text-slate-500 dark:text-slate-400 font-medium">ID: #{{product.id}}</span>
          {{#if (eq product.status 'banned')}}
            <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-rose-50 text-rose-800 border border-rose-200 dark:bg-rose-950/60 dark:text-rose-300 dark:border-rose-800">Status: Banned</span>
          {{else if (eq product.status 'archived')}}
            <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-200 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800">Status: Archived</span>
          {{else}}
            <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800">Status: Active</span>
          {{/if}}
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400">Authorized administrative override for this catalog entity.</p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <a
          href="/catalog/manage/{{product.id}}/edit"
          class="px-3 py-1.5 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-lg text-xs font-semibold transition-colors border border-slate-300 dark:border-slate-700 shadow-sm"
        >
          Edit details
        </a>

        {{#if (eq product.status 'banned')}}
          <form method="POST" action="/catalog/manage/{{product.id}}/unban" class="inline">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button
              type="submit"
              onclick="return confirm('Reinstate this food product to active catalog status?');"
              class="px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-semibold transition-colors shadow-sm"
            >
              Reinstate product
            </button>
          </form>
        {{else}}
          <button
            type="button"
            onclick="openBanProductModal()"
            class="px-3 py-1.5 bg-rose-700 hover:bg-rose-800 text-white rounded-lg text-xs font-semibold transition-colors shadow-sm inline-flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
            Ban food item
          </button>
        {{/if}}

        {{#if (ne product.status 'archived')}}
          <form method="POST" action="/catalog/manage/{{product.id}}/archive" class="inline">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button
              type="submit"
              onclick="return confirm('Archive this food product? It will be hidden from consumer discovery.');"
              class="px-3 py-1.5 bg-white dark:bg-slate-800 hover:bg-amber-50 dark:hover:bg-amber-950/40 text-slate-700 hover:text-amber-800 dark:text-slate-300 dark:hover:text-amber-300 rounded-lg text-xs font-semibold transition-colors border border-slate-300 dark:border-slate-700 hover:border-amber-300 shadow-sm"
            >
              Archive
            </button>
          </form>
        {{/if}}

        <button
          type="button"
          onclick="openDeleteProductModal()"
          class="px-3 py-1.5 bg-white dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-700 hover:text-rose-700 dark:text-slate-300 dark:hover:text-rose-400 border border-slate-300 dark:border-slate-700 hover:border-rose-300 dark:hover:border-rose-800 rounded-lg text-xs font-semibold transition-colors shadow-sm"
        >
          Permanently delete
        </button>
      </div>
    </div>
  {{/if}}

  <!-- Regulatory Health & Safety Ban Docket (Displayed when product is banned) -->
  {{#if (eq product.status 'banned')}}
    <div class="bg-rose-950 border-2 border-rose-700 rounded-xl p-6 sm:p-7 text-rose-100 space-y-4 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-rose-800/80 pb-4">
        <div class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-lg bg-rose-800 text-white flex items-center justify-center font-black text-lg flex-shrink-0">
            !
          </span>
          <div>
            <span class="text-[11px] font-mono font-bold tracking-wide text-rose-300 uppercase block">Statutory Recall & Safety Advisory</span>
            <h2 class="text-lg font-black text-white tracking-tight">Product formulation banned from circulation</h2>
          </div>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-rose-900/80 border border-rose-700 text-xs font-mono text-rose-200">
          <span>Barcode:</span>
          <strong>{{product.barcode}}</strong>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="md:col-span-2 space-y-2">
          <span class="font-semibold text-rose-300 block">Formal regulatory violation / ban rationale:</span>
          <div class="bg-rose-900/40 border border-rose-800 rounded-lg p-3.5 text-rose-100 font-medium leading-relaxed">
            {{#if product.banReason}}
              {{product.banReason}}
            {{else}}
              Product failed statutory food safety and label verification compliance standards.
            {{/if}}
          </div>
          <p class="text-[11px] text-rose-300 leading-normal">
            Consumers holding packaging with this barcode are instructed not to ingest this item. Commercial retail sale or redistribution is prohibited under food safety directives.
          </p>
        </div>

        <div class="bg-rose-900/30 border border-rose-800/60 rounded-lg p-3.5 space-y-2 text-xs">
          <span class="font-semibold text-rose-300 block">Quarantine record</span>
          <div class="space-y-1 text-[11px] text-rose-200">
            <div>Status: <strong class="text-white">Statutory Quarantine</strong></div>
            {{#if product.bannedAt}}
              <div>Action date: <strong class="text-white font-mono">{{product.bannedAt}}</strong></div>
            {{/if}}
            <div>Issuing body: <strong class="text-white">TrueLabel Food Safety Directorate</strong></div>
          </div>
          {{#if (eq user.role 'admin')}}
            <div class="pt-2">
              <form method="POST" action="/catalog/manage/{{product.id}}/unban">
                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                <button
                  type="submit"
                  class="w-full text-center px-3 py-1.5 bg-rose-800 hover:bg-rose-700 text-white rounded text-xs font-semibold transition-colors"
                >
                  Reinstate product formulation
                </button>
              </form>
            </div>
          {{/if}}
        </div>
      </div>
    </div>
  {{/if}}

  <!-- Breadcrumb & Actions Bar -->
  <div class="flex items-center justify-between">
    <a href="/catalog" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
      &larr; Back to food catalog
    </a>
    <div class="flex items-center gap-3">
      {{#if isOwner}}
        <a href="/catalog/manage/{{product.id}}/edit" class="text-xs font-semibold px-3 py-1.5 rounded-md border border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors">
          Edit food details
        </a>
      {{/if}}
      <span class="text-xs font-mono text-slate-400">Barcode: {{product.barcode}}</span>
    </div>
  </div>

  <!-- Main Product Header: Editorial Dossier Hero -->
  <div class="bg-white border border-slate-200 rounded-xl p-6 sm:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
    <div class="space-y-2">
      <div class="text-xs font-semibold text-slate-500">
        <span class="text-slate-900 font-bold">{{product.brand}}</span> &bull; <span>{{product.category}}</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">{{product.name}}</h1>
      {{#if product.description}}
        <p class="text-sm text-slate-600 max-w-2xl leading-relaxed">{{product.description}}</p>
      {{/if}}
      
      <!-- Dietary Tags -->
      {{#if product.dietaryTags.length}}
        <div class="flex flex-wrap gap-1.5 pt-1">
          {{#each product.dietaryTags}}
            <span class="text-xs font-semibold px-2.5 py-1 bg-slate-100 text-slate-700 rounded-md">
              {{this}}
            </span>
          {{/each}}
        </div>
      {{/if}}
    </div>

    <!-- Explainable Food Quality Score Seal -->
    <div class="flex flex-col items-center justify-center p-5 rounded-xl bg-slate-50 border border-slate-200 text-center min-w-[170px] self-stretch md:self-auto">
      <span class="text-xs font-medium text-slate-500">Quality score</span>
      <div class="text-4xl font-black mt-1 font-mono {{#if (gte product.qualityScore 80)}}text-emerald-800{{else}}{{#if (gte product.qualityScore 60)}}text-amber-800{{else}}text-rose-800{{/if}}{{/if}}">
        {{product.qualityScore}}<span class="text-base text-slate-400 font-normal font-sans">/100</span>
      </div>
      <div class="text-xs font-semibold mt-1 {{#if (gte product.qualityScore 80)}}text-emerald-800{{else}}{{#if (gte product.qualityScore 60)}}text-amber-800{{else}}text-rose-800{{/if}}{{/if}}">
        {{#if (gte product.qualityScore 80)}}Tier 1: High transparency{{else}}{{#if (gte product.qualityScore 60)}}Tier 2: Moderate quality{{else}}Tier 3: Elevated processing{{/if}}{{/if}}
      </div>
      <span class="text-[11px] text-slate-400 mt-0.5">Algorithm verified</span>
    </div>
  </div>

  <!-- FEATURE F16: Personalized Health & Allergen Conflict Engine (Consumers Only) -->
  {{#if (eq user.role 'consumer')}}
    {{#if conflictEvaluation.profileConfigured}}
      {{#if conflictEvaluation.hasAllergenConflict}}
        <div class="bg-rose-50 border-2 border-rose-600 rounded-xl p-5 space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-rose-600 text-white flex items-center justify-center font-bold text-xs">!</span>
              <h3 class="text-sm font-bold text-rose-950">Critical allergen conflict detected</h3>
            </div>
            <a href="/personal/profile" class="text-xs font-semibold text-rose-800 hover:text-rose-950 underline">Edit profile</a>
          </div>
          <p class="text-xs text-rose-900 leading-relaxed">
            This food product contains declared ingredients that conflict with your saved allergy profile:
          </p>
          <div class="space-y-1.5">
            {{#each conflictEvaluation.conflicts}}
              {{#if (eq this.category "allergen")}}
                <div class="p-2.5 rounded-lg bg-white border border-rose-300 text-xs flex items-start gap-2">
                  <span class="font-bold text-rose-700 text-[11px] px-1.5 py-0.5 bg-rose-100 rounded">Match</span>
                  <div>
                    <span class="font-bold text-rose-950">{{this.title}}</span>
                    <span class="block text-slate-700 text-[11px] mt-0.5">{{this.description}}</span>
                  </div>
                </div>
              {{/if}}
            {{/each}}
          </div>
        </div>
      {{/if}}

      {{#if conflictEvaluation.hasDietaryConflict}}
        <div class="bg-amber-50 border border-amber-300 rounded-xl p-4 space-y-2">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold text-amber-950">Dietary lifestyle conflict</h4>
            <a href="/personal/profile" class="text-xs font-semibold text-amber-800 hover:text-amber-950 underline">Edit profile</a>
          </div>
          {{#each conflictEvaluation.conflicts}}
            {{#if (eq this.category "dietary")}}
              <p class="text-xs text-amber-900">{{this.description}}</p>
            {{/if}}
          {{/each}}
        </div>
      {{/if}}

      {{#if conflictEvaluation.hasNutritionWarning}}
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-3.5 text-xs text-blue-900 flex items-start gap-2">
          <span class="text-blue-700 font-bold">Note:</span>
          <div>
            <span class="font-semibold">Nutritional target threshold:</span>
            {{#each conflictEvaluation.conflicts}}
              {{#if (eq this.category "nutrition")}}
                <span class="block text-[11px] text-blue-800 mt-0.5">{{this.description}}</span>
              {{/if}}
            {{/each}}
          </div>
        </div>
      {{/if}}

      {{#if conflictEvaluation.isSafeForUser}}
        <div class="bg-emerald-50 border border-emerald-300 rounded-xl p-4 flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 bg-emerald-700 text-white rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0">✓</div>
            <div>
              <h4 class="text-xs font-bold text-emerald-950">Clear for your dietary profile</h4>
              <p class="text-xs text-emerald-800 mt-0.5">
                No declared allergens or dietary restrictions from your profile ({{#each userProfile.allergies}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{#if userProfile.dietaryPreferences.length}} &bull; {{#each userProfile.dietaryPreferences}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}) were flagged in this product.
              </p>
            </div>
          </div>
          <a href="/personal/profile" class="text-xs font-semibold text-emerald-800 hover:text-emerald-950 underline flex-shrink-0">My profile</a>
        </div>
      {{/if}}

    {{else}}
      <!-- Profile Not Configured Callout -->
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <div class="text-xs font-bold text-slate-800">Personalize your allergen safety shield</div>
          <div class="text-xs text-slate-500 mt-0.5">Configure your allergy and dietary preferences to see real-time automated conflict warnings.</div>
        </div>
        <a href="/personal/profile" class="px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs rounded-lg text-center flex-shrink-0 transition-colors">
          Configure profile
        </a>
      </div>
    {{/if}}
  {{/if}}

  <!-- Allergen Warning Banner (If allergens declared) -->
  {{#if allergens.length}}
    <div class="bg-rose-50 border-2 border-rose-300 rounded-xl p-4 flex items-start gap-3">
      <div class="w-6 h-6 bg-rose-600 text-white rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">!</div>
      <div>
        <h4 class="text-sm font-bold text-rose-900">Declared allergen notice</h4>
        <p class="text-xs text-rose-800 mt-0.5">This food product contains declared allergens: 
          {{#each allergens}}
            <span class="font-semibold underline">{{this.name}} ({{this.allergenType}})</span>{{#unless @last}}, {{/unless}}
          {{/each}}.
        </p>
      </div>
    </div>
  {{/if}}

  <!-- Feature F11 & F13: Community Reviews Summary & Safety Reporting -->
  <section class="bg-white border border-slate-200 rounded-xl p-6 space-y-5">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-4">
      <div class="space-y-1">
        <h2 class="text-base font-bold text-slate-950">Consumer reviews and safety reports</h2>
        <p class="text-xs text-slate-500">
          Credibility-weighted ratings from verified accounts (independent of the lab-based Food Quality Score) and private safety reporting.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href="/community/products/{{product.id}}/reviews"
          class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-lg font-semibold text-xs transition-colors"
        >
          {{#if reviewSummary.reviewCount}}Read all {{reviewSummary.reviewCount}} reviews{{else}}Write the first review{{/if}}
        </a>
        {{#if (eq user.role 'consumer')}}
          <a
            href="/community/products/{{product.id}}/report"
            class="px-4 py-2 border border-rose-300 bg-rose-50 hover:bg-rose-100 text-rose-800 rounded-lg font-semibold text-xs transition-colors"
          >
            Report a product issue
          </a>
        {{/if}}
      </div>
    </div>

    {{#if reviewSummary.reviewCount}}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Aggregate & Dimension Summary -->
        <div class="lg:col-span-5 space-y-3">
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-black font-mono text-slate-950">{{reviewSummary.averageRating}}</span>
            <span class="text-xs font-mono text-slate-500">/ 5.0 weighted average ({{reviewSummary.reviewCount}} {{#if (eq reviewSummary.reviewCount 1)}}review{{else}}reviews{{/if}})</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
            {{#each reviewSummary.dimensionAverages}}
              <div class="bg-slate-50 border border-slate-100 rounded-md px-3 py-2">
                <span class="text-slate-500 block text-[11px]">{{this.label}}</span>
                <span class="font-mono font-bold text-slate-900">{{this.score}} / 5</span>
              </div>
            {{/each}}
          </div>
        </div>

        <!-- Recent Review Excerpts -->
        <div class="lg:col-span-7 divide-y divide-slate-100 border border-slate-100 rounded-lg bg-slate-50/50">
          {{#each reviewSummary.recentReviews}}
            <div class="p-4 space-y-1">
              <div class="flex items-center justify-between gap-2 text-xs">
                <span class="font-bold text-slate-900">{{this.authorName}} <span class="font-mono font-normal text-slate-500 ml-1">({{this.weightFormatted}})</span></span>
                <span class="font-mono font-bold text-emerald-800">{{this.rating}} / 5</span>
              </div>
              {{#if this.title}}
                <div class="text-xs font-semibold text-slate-800">{{this.title}}</div>
              {{/if}}
              <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">{{this.comment}}</p>
            </div>
          {{/each}}
        </div>
      </div>
    {{else}}
      <div class="text-xs text-slate-500">
        No consumer reviews recorded yet. Consumers can share structured ratings on taste, label accuracy, packaging condition, and purchase experience.
      </div>
    {{/if}}
  </section>

  <!-- Detailed Inspection: Nutrition Panel vs Ingredient Transparency -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- LEFT: FDA/EU Style Authentic Nutrition Facts Box (5 cols) with Dynamic Serving Scaler -->
    <div class="lg:col-span-5 bg-white dark:bg-[#141413] p-6 border border-slate-200 dark:border-white/10 rounded-xl shadow-sm serving-scaler-container" data-base-serving="{{#if product.servingSize}}{{product.servingSize}}{{else}}100{{/if}}" data-serving-unit="{{#if product.servingUnit}}{{product.servingUnit}}{{else}}g{{/if}}">
      
      <!-- Interactive Modern Portion Scaler (Fontsight & Modern Slider Mechanics) -->
      <div class="mb-5 p-4 bg-gradient-to-br from-slate-50 to-emerald-50/30 dark:from-slate-800/80 dark:to-emerald-950/20 rounded-2xl border border-slate-200/90 dark:border-white/10 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">
              Interactive Portion Scaler
            </span>
          </div>
          <div class="flex items-baseline gap-1 bg-white dark:bg-slate-900 px-3 py-1 rounded-lg border border-slate-200 dark:border-slate-700 shadow-xs">
            <span data-serving-display class="font-mono text-emerald-700 dark:text-emerald-400 font-black text-base">{{product.servingSize}}{{product.servingUnit}}</span>
          </div>
        </div>

        <!-- Modern Slider Track with Custom Pointer -->
        <div class="relative py-1">
          <input
            type="range"
            data-serving-slider
            data-a90-cursor="scale"
            min="10"
            max="250"
            step="5"
            value="{{#if product.servingSize}}{{product.servingSize}}{{else}}100{{/if}}"
            class="serving-slider w-full"
            aria-label="Adjust serving size"
          />
        </div>

        <!-- Modern Clickable Preset Chips with Pointer Cursor (Touch-Friendly) -->
        <div class="flex flex-wrap items-center justify-between gap-1.5 pt-0.5">
          <button type="button" data-preset-val="25" class="serving-preset-btn min-h-[38px] px-3 py-1.5 rounded-md text-[10px] font-mono font-bold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 cursor-pointer transition-all flex items-center justify-center">
            25g
          </button>
          <button type="button" data-preset-val="50" class="serving-preset-btn min-h-[38px] px-3 py-1.5 rounded-md text-[10px] font-mono font-bold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 cursor-pointer transition-all flex items-center justify-center">
            50g
          </button>
          <button type="button" data-preset-val="100" class="serving-preset-btn min-h-[38px] px-3 py-1.5 rounded-md text-[10px] font-mono font-bold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 cursor-pointer transition-all flex items-center justify-center">
            100g (Std)
          </button>
          <button type="button" data-preset-val="150" class="serving-preset-btn min-h-[38px] px-3 py-1.5 rounded-md text-[10px] font-mono font-bold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 cursor-pointer transition-all flex items-center justify-center">
            150g
          </button>
          <button type="button" data-preset-val="250" class="serving-preset-btn min-h-[38px] px-3 py-1.5 rounded-md text-[10px] font-mono font-bold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 cursor-pointer transition-all flex items-center justify-center">
            250g
          </button>
        </div>
      </div>

      <div class="nutrition-panel mx-auto">
        <h3>Nutrition Facts</h3>
        
        <div class="nutrition-serving-header">
          <div class="text-sm font-bold text-slate-900 dark:text-slate-100">
            Serving size: <span data-serving-display class="font-mono text-emerald-700 dark:text-emerald-400 font-extrabold">{{product.servingSize}}{{product.servingUnit}}</span>
          </div>
          <div class="text-xs text-slate-500 font-normal">
            Amounts scaled dynamically for <span data-serving-display class="font-mono font-semibold">{{product.servingSize}}{{product.servingUnit}}</span> portion
          </div>
        </div>

        <div class="nutrition-calories-row" data-base-nutrient="Energy" data-base-val="{{#each product.nutritionFacts}}{{#if (eq this.nutrient 'Energy')}}{{this.amountPer100g}}{{/if}}{{/each}}" data-base-unit="kcal" data-dv-daily="2000">
          <div>
            <div class="text-xs font-bold uppercase tracking-tight">Energy / Calories</div>
            <div class="text-[11px] text-slate-500 font-medium">Per <span data-serving-display>{{product.servingSize}}{{product.servingUnit}}</span> portion</div>
          </div>
          <div class="nutrition-calories-number font-mono">
            <span data-val-display>
              {{#each product.nutritionFacts}}
                {{#if (eq this.nutrient "Energy")}}{{this.amountPer100g}}{{/if}}
              {{/each}}
            </span>
            <span class="text-sm font-bold font-sans">kcal</span>
          </div>
        </div>

        <!-- Nutrition Facts Breakdown with Waterfall Progress Bars -->
        <div class="space-y-1.5 text-xs pt-1">
          {{#each product.nutritionFacts}}
            {{#unless (eq this.nutrient "Energy")}}
              <div
                class="nutrition-row {{#if (or (eq this.nutrient 'Saturated Fat') (eq this.nutrient 'Sugars'))}}indent{{/if}}"
                data-base-nutrient="{{this.nutrient}}"
                data-base-val="{{this.amountPer100g}}"
                data-base-unit="{{this.unit}}"
                data-dv-daily="{{#if (eq this.nutrient 'Fat')}}78{{else}}{{#if (eq this.nutrient 'Saturated Fat')}}20{{else}}{{#if (eq this.nutrient 'Carbohydrates')}}275{{else}}{{#if (eq this.nutrient 'Sugars')}}50{{else}}{{#if (eq this.nutrient 'Protein')}}50{{else}}{{#if (eq this.nutrient 'Salt')}}6{{else}}100{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}"
              >
                <div class="flex-grow pr-2">
                  <div class="flex items-center justify-between mb-1">
                    <span class="{{#if (or (eq this.nutrient 'Fat') (eq this.nutrient 'Carbohydrates') (eq this.nutrient 'Protein') (eq this.nutrient 'Salt'))}}font-bold{{else}}text-slate-700 dark:text-slate-300{{/if}}">
                      {{this.nutrient}}
                    </span>
                    <span class="font-mono font-semibold" data-val-display>
                      {{this.amountPer100g}}{{this.unit}}
                    </span>
                  </div>
                  <!-- Fontsight-inspired Waterfall Progress Track -->
                  <div class="nutrition-waterfall-track">
                    <div class="nutrition-waterfall-fill bg-emerald-600" style="width: 25%;"></div>
                  </div>
                </div>
                <div class="font-mono font-bold text-right pl-2 w-12 text-slate-500" data-dv-display>
                  --%
                </div>
              </div>
            {{/unless}}
          {{/each}}
        </div>

        <div class="mt-4 pt-2 border-t-2 border-slate-900 dark:border-white/20 text-[10px] text-slate-500 leading-tight">
          * Dynamic Daily Values (% DV) based on a 2,000 calorie reference diet. Recalculated in real-time.
        </div>
      </div>
    </div>

    <!-- RIGHT: Declared Ingredients & Additives Breakdown (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- Ingredients Card -->
      <div class="bg-white dark:bg-[#141413] border border-slate-200 dark:border-white/10 rounded-xl p-6 shadow-sm">
        <h3 class="text-base font-black text-slate-900 dark:text-slate-100 tracking-tight flex items-center justify-between">
          <span>Declared Ingredients & Chemical Additives</span>
          <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 font-normal">{{product.ingredients.length}} items identified</span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Hover over any ingredient to inspect forensic toxicology data, FDA/EU approvals, and copy monographs.</p>

        <div class="mt-4 space-y-2">
          {{#if product.ingredients.length}}
            {{#each product.ingredients}}
              <div
                data-inspectable-ingredient
                data-ingredient-name="{{this.name}}{{#if this.additiveCode}} ({{this.additiveCode}}){{/if}}"
                data-hazard="{{this.hazardLevel}}"
                data-hazard-detail="Classified as {{this.hazardLevel}} tier in food safety databases."
                data-fda-status="{{#if (eq this.hazardLevel 'safe')}}GRAS Verified{{else}}Restricted / Monitored{{/if}}"
                data-eu-status="{{#if this.additiveCode}}EU Authorized ({{this.additiveCode}}){{else}}EU Verified{{/if}}"
                data-allergen="{{#if this.isAllergen}}{{this.allergenType}}{{else}}false{{/if}}"
                data-citation="TrueLabel Food Safety Dossier for {{this.name}}"
                class="clinical-card cursor-help p-3 rounded-lg border {{#if this.isAllergen}}bg-rose-50/80 dark:bg-rose-950/40 border-rose-200 dark:border-rose-800{{else}}{{#if this.additiveCode}}bg-amber-50/80 dark:bg-amber-950/40 border-amber-200 dark:border-amber-800{{else}}bg-slate-50/80 dark:bg-slate-800/40 border-slate-200 dark:border-slate-700{{/if}}{{/if}} flex items-center justify-between text-xs"
              >
                <div>
                  <span class="font-bold text-slate-900 dark:text-slate-100">{{this.name}}</span>
                  {{#if this.additiveCode}}
                    <span class="ml-2 additive-pill">Additive: {{this.additiveCode}}</span>
                  {{/if}}
                  {{#if this.isAllergen}}
                    <span class="ml-2 allergen-pill">Allergen: {{this.allergenType}}</span>
                  {{/if}}
                </div>
                <span class="text-[11px] font-bold uppercase {{#if (eq this.hazardLevel 'warning')}}text-rose-700 dark:text-rose-400{{else}}{{#if (eq this.hazardLevel 'caution')}}text-amber-700 dark:text-amber-400{{else}}text-emerald-700 dark:text-emerald-400{{/if}}{{/if}}">
                  {{this.hazardLevel}}
                </span>
              </div>
            {{/each}}
          {{else}}
            <div class="text-xs text-slate-400 italic p-3">No ingredients declared for this food product yet.</div>
          {{/if}}
        </div>
      </div>

      <!-- Additives & Safety Info -->
      <div class="bg-white dark:bg-[#141413] border border-slate-200 dark:border-white/10 rounded-xl p-6 shadow-sm">
        <h4 class="text-sm font-black text-slate-900 dark:text-slate-100 tracking-tight">Food Safety & Compliance Summary</h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4 mt-3 text-xs">
          <div class="p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
            <div class="text-slate-400 dark:text-slate-500 font-bold uppercase text-[10px]">Additives Count</div>
            <div class="text-lg font-black text-slate-800 dark:text-slate-200 mt-0.5">{{additives.length}} identified</div>
          </div>
          <div class="p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
            <div class="text-slate-400 dark:text-slate-500 font-bold uppercase text-[10px]">Allergen Flag Count</div>
            <div class="text-lg font-black {{#if allergens.length}}text-rose-700 dark:text-rose-400{{else}}text-emerald-700 dark:text-emerald-400{{/if}} mt-0.5">
              {{allergens.length}} flagged
            </div>
          </div>
        </div>

        <!-- Verified Accreditation Micro-Seals (A90 88x31-inspired) -->
        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-white/10 space-y-2">
          <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Accredited Safety Seals</div>
          <div class="flex flex-wrap gap-2">
            <span class="cert-seal-badge bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-700">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              ISO 22000
            </span>
            <span class="cert-seal-badge bg-blue-50 dark:bg-blue-950/50 text-blue-800 dark:text-blue-300 border-blue-300 dark:border-blue-700">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
              BSTI CERTIFIED
            </span>
            <span class="cert-seal-badge bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-600">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-600"></span>
              NON-GMO VERIFIED
            </span>
          </div>
        </div>

        <!-- Cryptographic Batch Imprint Visual Seal (A90 144px Imprint Canvas) -->
        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-white/10 flex items-center justify-between">
          <div class="space-y-0.5">
            <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Cryptographic Batch Seal</div>
            <div class="text-xs font-semibold text-slate-700 dark:text-slate-300">Lot Verification Hash: <code class="font-mono text-[11px]">{{product.barcode}}</code></div>
            <div class="text-[10px] text-slate-400 dark:text-slate-500">Deterministic 12x12 visual verification matrix</div>
          </div>
          <canvas
            class="batch-imprint-canvas shrink-0"
            data-batch-imprint
            data-a90-reticle
            data-batch-code="{{product.barcode}}"
            data-pixel-size="4"
            width="48"
            height="48"
            title="Deterministic Cryptographic Batch Hash"
          ></canvas>
        </div>
      </div>

    </div>
  </div>
</div>

{{#if (eq user.role 'admin')}}
  <!-- Modal: Administrative Ban Food Product -->
  <div
    id="banProductModal"
    class="!m-0 fixed inset-0 z-[100] bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden"
    onclick="if (event.target === this) closeBanProductModal()"
  >
    <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full max-h-[90vh] flex flex-col border border-slate-200 overflow-hidden transform transition-all">
      <div class="p-4 sm:p-6 border-b border-slate-100 flex items-center justify-between bg-rose-50/50">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-rose-700 text-white flex items-center justify-center text-xs font-bold">!</span>
          <div>
            <h3 class="text-base font-bold text-slate-900">Ban food product from website</h3>
            <p class="text-xs text-slate-500">Statutory quarantine & regulatory notice</p>
          </div>
        </div>
        <button
          type="button"
          onclick="closeBanProductModal()"
          class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg min-h-[36px] min-w-[36px] flex items-center justify-center"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <form method="POST" action="/catalog/manage/{{product.id}}/ban" class="p-4 sm:p-6 space-y-4 overflow-y-auto flex-grow">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">
            Mandatory regulatory violation / ban reason <span class="text-rose-600">*</span>
          </label>
          <textarea
            name="reason"
            required
            rows="4"
            placeholder="Specify laboratory finding, undeclared allergen, toxic additive, counterfeit report reference, or statutory BFSA/FDA recall docket..."
            class="w-full text-xs rounded-lg border border-slate-300 p-3 bg-white text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-700"
          ></textarea>
          <p class="text-[11px] text-slate-400 mt-1">Minimum 5 characters. This explanation will be displayed publicly on the product's safety advisory docket.</p>
        </div>

        <div class="pt-2 flex items-center justify-end gap-2.5">
          <button
            type="button"
            onclick="closeBanProductModal()"
            class="min-h-[44px] px-4 py-2 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-lg text-xs font-semibold transition-colors"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="min-h-[44px] px-4 py-2 bg-rose-700 hover:bg-rose-800 text-white rounded-lg text-xs font-semibold transition-colors shadow-sm"
          >
            Confirm regulatory ban
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Administrative Permanent Deletion -->
  <div
    id="deleteProductModal"
    class="!m-0 fixed inset-0 z-[100] bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden"
    onclick="if (event.target === this) closeDeleteProductModal()"
  >
    <div class="bg-white rounded-xl shadow-2xl max-w-lg w-full max-h-[90vh] flex flex-col border border-slate-200 overflow-hidden transform transition-all">
      <div class="p-4 sm:p-6 border-b border-slate-100 flex items-center justify-between bg-rose-50/50">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-rose-700 text-white flex items-center justify-center text-xs font-bold">&times;</span>
          <div>
            <h3 class="text-base font-bold text-slate-900">Permanently delete food formulation</h3>
            <p class="text-xs text-rose-600 font-semibold">Irreversible administrative wipe</p>
          </div>
        </div>
        <button
          type="button"
          onclick="closeDeleteProductModal()"
          class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg min-h-[36px] min-w-[36px] flex items-center justify-center"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <form method="POST" action="/catalog/manage/{{product.id}}/delete" class="p-4 sm:p-6 space-y-4 overflow-y-auto flex-grow">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <p class="text-xs text-slate-600 leading-relaxed">
          You are about to permanently delete <strong>{{product.name}}</strong> (Barcode: <code class="font-mono bg-slate-100 px-1 py-0.5 rounded text-slate-800">{{product.barcode}}</code>). This will delete all declared ingredients, nutrition facts, and associated records.
        </p>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">
            Type the barcode <strong class="font-mono text-slate-900">{{product.barcode}}</strong> to confirm:
          </label>
          <input
            type="text"
            id="confirmDeleteBarcode"
            oninput="document.getElementById('confirmDeleteBtn').disabled = (this.value.trim() !== '{{product.barcode}}')"
            placeholder="Enter barcode exactly"
            class="w-full text-xs rounded-lg border border-slate-300 px-3 py-2 bg-white text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-700 font-mono min-h-[44px]"
          />
        </div>

        <div class="pt-2 flex items-center justify-end gap-2.5">
          <button
            type="button"
            onclick="closeDeleteProductModal()"
            class="min-h-[44px] px-4 py-2 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-lg text-xs font-semibold transition-colors"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="confirmDeleteBtn"
            disabled
            class="min-h-[44px] px-4 py-2 bg-rose-700 hover:bg-rose-800 disabled:opacity-40 disabled:cursor-not-allowed text-white rounded-lg text-xs font-semibold transition-colors shadow-sm"
          >
            Delete product permanently
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openBanProductModal() {
      document.getElementById('banProductModal').classList.remove('hidden');
    }
    function closeBanProductModal() {
      document.getElementById('banProductModal').classList.add('hidden');
    }
    function openDeleteProductModal() {
      document.getElementById('deleteProductModal').classList.remove('hidden');
    }
    function closeDeleteProductModal() {
      document.getElementById('deleteProductModal').classList.add('hidden');
    }
  </script>
{{/if}}

