<div class="max-w-3xl mx-auto my-4 sm:my-6 bg-white p-4 sm:p-8 border border-slate-200 rounded-xl">
  <div class="mb-6 pb-4 border-b border-slate-200">
    <a href="/catalog" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">Back to food catalog</a>
    <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-2">Register packaged food product</h1>
    <p class="text-sm text-slate-500 mt-1">Submit verified packaged food declarations including statutory nutrition facts and ingredient lists.</p>
  </div>

  {{#if licenceBlocked}}
    <div class="p-6 rounded-xl bg-amber-50 border border-amber-300 text-amber-900 space-y-3">
      <div class="flex items-start gap-3">
        <span class="text-xl">🔒</span>
        <div>
          <p class="font-bold text-sm mb-1">Corporate accreditation required</p>
          <p class="text-sm text-amber-800">{{error}}</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href="/safety/documents/upload" class="inline-block bg-amber-700 text-white text-xs font-semibold px-4 py-2 rounded-lg hover:bg-amber-800 transition-colors">
              Submit safety document
            </a>
            <a href="/safety/documents" class="inline-block border border-amber-700 text-amber-900 text-xs font-semibold px-4 py-2 rounded-lg hover:bg-amber-100 transition-colors">
              View document status
            </a>
          </div>
        </div>
      </div>
    </div>
  {{else}}

  <form action="/catalog/manage/create" method="POST" class="space-y-6">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    
    <!-- Section 1: Basic Identity -->
    <div class="space-y-4">
      <div>
        <h2 class="text-sm font-bold text-slate-900">Basic identification</h2>
        <p class="text-xs text-slate-500 mt-0.5">Commercial name, brand, category, and barcode</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Food name *</label>
          <input
            type="text"
            name="name"
            required
            placeholder="e.g. Organic Almond Milk Unsweetened"
            value="{{productData.name}}"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Brand name *</label>
          <input
            type="text"
            name="brand"
            required
            placeholder="e.g. PureHarvest"
            value="{{productData.brand}}"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Category *</label>
          <select
            name="category"
            required
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 bg-white"
          >
            {{#each categories}}
              <option value="{{this}}" {{#if (eq ../productData.category this)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Barcode (EAN/UPC) *</label>
          <input
            type="text"
            name="barcode"
            required
            placeholder="e.g. 9312345678901"
            value="{{#if productData.barcode}}{{productData.barcode}}{{else}}{{barcode}}{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 font-mono"
          />
          <span class="text-[11px] text-slate-400 block mt-0.5">Must be unique across the catalog</span>
        </div>
      </div>
    </div>

    <!-- Section 2: Serving Details & Description -->
    <div class="pt-5 border-t border-slate-200 space-y-4">
      <div>
        <h2 class="text-sm font-bold text-slate-900">Serving size and description</h2>
        <p class="text-xs text-slate-500 mt-0.5">Standard serving parameters and dietary tags</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Serving size</label>
          <input
            type="number"
            name="servingSize"
            value="{{#if productData.servingSize}}{{productData.servingSize}}{{else}}100{{/if}}"
            step="0.1"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Serving unit</label>
          <select
            name="servingUnit"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 bg-white"
          >
            <option value="g" {{#if (eq productData.servingUnit 'g')}}selected{{/if}}>Grams (g)</option>
            <option value="ml" {{#if (eq productData.servingUnit 'ml')}}selected{{/if}}>Milliliters (ml)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Dietary tags</label>
          <input
            type="text"
            name="dietaryTags"
            placeholder="Vegan, Gluten-Free, Halal"
            value="{{productData.dietaryTags}}"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
          <span class="text-[11px] text-slate-400 block mt-0.5">Comma-separated</span>
        </div>
      </div>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Product description</label>
        <textarea
          name="description"
          rows="2"
          placeholder="Brief summary of product characteristics..."
          class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
        >{{productData.description}}</textarea>
      </div>
    </div>

    <!-- Section 3: Statutory Nutrition Facts Panel (per 100g / 100ml) -->
    {{> _nutrition_facts_form}}

    <!-- Section 4: Declared Ingredients & Additives -->
    <div class="pt-5 border-t border-slate-200 space-y-3">
      <div>
        <h2 class="text-sm font-bold text-slate-900">Declared ingredients and additives</h2>
        <p class="text-xs text-slate-500 mt-0.5">Enter ingredients as listed on the packaged product label</p>
      </div>
      <textarea
        name="rawIngredients"
        rows="3"
        placeholder="e.g. Oat Base (Water, Oats 10%), Rapeseed Oil, Dipotassium Phosphate (E340), Calcium Carbonate (E170), Sea Salt, Potassium Iodide"
        class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 font-sans"
      >{{productData.rawIngredients}}</textarea>
      <p class="text-xs text-slate-500">
        Allergens (Milk, Gluten, Peanuts, Tree Nuts, Soy, Celery) and additive E-numbers are automatically recognized and evaluated for the Transparency Score.
      </p>
    </div>

    <button
      type="submit"
      class="w-full py-3 px-6 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-sm rounded-lg transition-colors shadow-sm min-h-[44px] flex items-center justify-center"
    >
      Register food product to catalog
    </button>
  </form>
  {{/if}}
</div>

