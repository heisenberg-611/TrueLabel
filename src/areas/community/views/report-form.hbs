<!-- Feature F13: Food Complaint & Suspected Counterfeit Reporting Form -->
<div class="max-w-3xl mx-auto space-y-6 pb-12">

  <!-- Return Link -->
  <div class="flex items-center justify-between border-b border-slate-200 pb-3">
    <a href="/catalog/product/{{product.id}}" class="text-xs font-semibold text-slate-600 hover:text-slate-950 transition-colors">
      Back to {{product.name}} dossier
    </a>
    <a href="/community/reports/mine" class="text-xs font-semibold text-slate-700 hover:text-slate-950 underline">
      View my submitted reports
    </a>
  </div>

  <!-- Urgent Medical Safety Notice (Rule 4.3 & Proposal Non-Functional Requirement) -->
  <div class="bg-rose-50 border border-rose-300 rounded-xl p-4 flex items-start gap-3">
    <div class="w-6 h-6 rounded-full bg-rose-700 text-white font-black text-xs flex items-center justify-center flex-shrink-0 mt-0.5">!</div>
    <div class="text-xs text-rose-950 leading-relaxed">
      <strong class="font-bold">Health safety priority:</strong> If you or someone else experienced an allergic reaction, food poisoning, or suspected contamination, seek immediate medical assistance first. Filing a complaint does not substitute for medical care.
    </div>
  </div>

  {{#if error}}
    <div class="bg-rose-50 border border-rose-200 text-rose-900 px-4 py-3 rounded-lg text-sm font-medium">
      {{error}}
    </div>
  {{/if}}

  <!-- Regulatory Incident Filing Sheet -->
  <form
    method="POST"
    action="/community/products/{{product.id}}/report?_csrf={{csrfToken}}"
    enctype="multipart/form-data"
    class="bg-white border border-slate-200 rounded-xl overflow-hidden"
  >
    <input type="hidden" name="_csrf" value="{{csrfToken}}">

    <!-- Form Header -->
    <div class="p-6 sm:p-8 border-b border-slate-200 bg-slate-50/70">
      <div class="text-xs font-semibold text-rose-700">Confidential food safety complaint</div>
      <h1 class="text-2xl font-black text-slate-950 tracking-tight mt-1">
        Report an issue with {{product.name}}
      </h1>
      <p class="text-sm text-slate-600 mt-1.5">
        Brand: <strong class="text-slate-900">{{product.brand}}</strong>
        <span class="mx-2 text-slate-300">|</span>
        Barcode: <span class="font-mono text-slate-800">{{product.barcode}}</span>
      </p>
      <p class="text-xs text-slate-500 mt-2 max-w-2xl">
        Reports are routed privately to authorized food-safety inspectors and administrators. They are not published as consumer reviews, and you will receive a unique tracking reference number upon submission.
      </p>
    </div>

    <div class="p-6 sm:p-8 space-y-6">
      <!-- Section 1: Problem Classification -->
      <fieldset class="space-y-3">
        <legend class="text-sm font-bold text-slate-900">1. Problem classification</legend>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
          <label class="flex items-start gap-2.5 p-3 border border-slate-200 rounded-lg cursor-pointer hover:border-slate-400">
            <input type="radio" name="category" value="counterfeit" required {{#if (eq formData.category 'counterfeit')}}checked{{else}}{{#unless formData.category}}checked{{/unless}}{{/if}} class="mt-0.5">
            <span>
              <strong class="block text-slate-900">Suspected counterfeit</strong>
              <span class="text-slate-500">Tampered seal, misspelled label, or duplicate batch code</span>
            </span>
          </label>
          <label class="flex items-start gap-2.5 p-3 border border-slate-200 rounded-lg cursor-pointer hover:border-slate-400">
            <input type="radio" name="category" value="spoiled" {{#if (eq formData.category 'spoiled')}}checked{{/if}} class="mt-0.5">
            <span>
              <strong class="block text-slate-900">Spoiled food</strong>
              <span class="text-slate-500">Unusual odor, mold, discoloration, or curdling before expiry</span>
            </span>
          </label>
          <label class="flex items-start gap-2.5 p-3 border border-slate-200 rounded-lg cursor-pointer hover:border-slate-400">
            <input type="radio" name="category" value="contaminated" {{#if (eq formData.category 'contaminated')}}checked{{/if}} class="mt-0.5">
            <span>
              <strong class="block text-slate-900">Suspected contamination</strong>
              <span class="text-slate-500">Foreign material, chemical smell, or illness concern</span>
            </span>
          </label>
          <label class="flex items-start gap-2.5 p-3 border border-slate-200 rounded-lg cursor-pointer hover:border-slate-400">
            <input type="radio" name="category" value="damaged" {{#if (eq formData.category 'damaged')}}checked{{/if}} class="mt-0.5">
            <span>
              <strong class="block text-slate-900">Damaged packaging</strong>
              <span class="text-slate-500">Swollen container, broken seal, or leaking pack at purchase</span>
            </span>
          </label>
          <label class="flex items-start gap-2.5 p-3 border border-slate-200 rounded-lg cursor-pointer hover:border-slate-400 sm:col-span-2">
            <input type="radio" name="category" value="mislabelled" {{#if (eq formData.category 'mislabelled')}}checked{{/if}} class="mt-0.5">
            <span>
              <strong class="block text-slate-900">Incorrect or misleading label</strong>
              <span class="text-slate-500">Missing allergen disclosure, obscured expiry date, or conflicting nutrition values</span>
            </span>
          </label>
        </div>
      </fieldset>

      <!-- Section 2: Batch & Purchase Traceability -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-slate-100">
        <label class="block text-xs font-semibold text-slate-700">
          Batch or lot number (optional, links related complaints)
          <input
            name="batchCode"
            maxlength="80"
            value="{{formData.batchCode}}"
            class="mt-1.5 block w-full border border-slate-300 rounded-md p-2.5 text-sm font-mono bg-white"
            placeholder="e.g. BATCH-2026-B4"
          >
        </label>
        <label class="block text-xs font-semibold text-slate-700">
          Purchase location <span class="text-rose-600">*</span>
          <input
            name="purchasePlace"
            required
            minlength="2"
            maxlength="200"
            value="{{formData.purchasePlace}}"
            class="mt-1.5 block w-full border border-slate-300 rounded-md p-2.5 text-sm bg-white"
            placeholder="Store name, branch, or neighborhood"
          >
        </label>
      </div>

      <!-- Section 3: Incident Description -->
      <div class="pt-4 border-t border-slate-100">
        <label class="block text-xs font-semibold text-slate-700">
          What happened? <span class="text-rose-600">*</span>
          <span class="font-normal text-slate-500">(minimum 20 characters)</span>
          <textarea
            name="description"
            rows="5"
            minlength="20"
            maxlength="2000"
            required
            class="mt-1.5 block w-full border border-slate-300 rounded-md p-2.5 text-sm bg-white leading-relaxed"
            placeholder="Describe the condition of the seal, printed expiry date, smell/appearance, and when you noticed the issue."
          >{{formData.description}}</textarea>
        </label>
      </div>

      <!-- Section 4: Optional Private Photo Evidence -->
      <div class="pt-4 border-t border-slate-100">
        <label class="block text-xs font-semibold text-slate-700">
          Photo evidence (optional)
          <input
            name="photo"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            class="mt-2 block w-full text-xs text-slate-600 file:mr-3 file:py-2 file:px-3.5 file:rounded-md file:border file:border-slate-300 file:text-xs file:font-semibold file:bg-slate-50 file:text-slate-800 hover:file:bg-slate-100"
          >
        </label>
        <p class="text-xs text-slate-500 mt-1.5">
          Accepted formats: JPEG, PNG, or WebP up to 3 MB. Magic bytes and MIME types are verified on upload; photos remain strictly private to you and authorized inspectors.
        </p>
      </div>

      <!-- Submit Row -->
      <div class="pt-4 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4">
        <p class="text-xs text-slate-500 max-w-md">
          A submitted report is treated as unverified until investigated by an authorized food-safety inspector.
        </p>
        <button type="submit" class="px-5 py-2.5 bg-rose-700 hover:bg-rose-800 text-white font-bold rounded-lg text-xs transition-colors">
          Submit complaint report
        </button>
      </div>
    </div>
  </form>
</div>
