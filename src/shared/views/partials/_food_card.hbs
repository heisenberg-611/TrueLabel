<div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm hover:border-slate-300 hover:shadow-md transition-all flex flex-col justify-between">
  <div>
    <!-- Category & Score Header -->
    <div class="flex items-start justify-between gap-2 mb-2.5">
      <span class="text-xs font-medium text-slate-500">{{this.category}}</span>
      
      <div class="flex items-center gap-1.5">
        {{#if (eq this.status 'banned')}}
          <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-rose-600 text-white">
            Banned
          </span>
        {{/if}}
        {{#if (or this.userConflict.hasAllergenConflict this.conflict.hasAllergenConflict)}}
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-rose-50 text-rose-800 border border-rose-200">
            Allergen alert
          </span>
        {{else}}
          {{#if (or this.conflict.hasDietaryConflict false)}}
            <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-200">
              Dietary alert
            </span>
          {{else}}
            {{#if (or (and this.userConflict.isSafeForUser this.userConflict.profileConfigured) (eq this.conflict.isSafe true))}}
              <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                Safe
              </span>
            {{/if}}
          {{/if}}
        {{/if}}
        
        <span class="score-badge px-2.5 py-0.5 text-xs font-bold font-mono {{#if (gte this.qualityScore 80)}}score-badge-high{{else}}{{#if (gte this.qualityScore 60)}}score-badge-mid{{else}}score-badge-low{{/if}}{{/if}}">
          {{this.qualityScore}} / 100
        </span>
      </div>
    </div>

    <!-- Brand & Food Name -->
    <div class="text-xs font-semibold text-slate-600">{{this.brand}}</div>
    <h3 class="text-base font-bold text-slate-900 leading-snug mt-0.5">
      <a href="/catalog/product/{{this.id}}" class="hover:text-emerald-800 transition-colors">
        {{this.name}}
      </a>
    </h3>

    <!-- Barcode & Serving -->
    <div class="text-xs text-slate-400 mt-1 font-mono">
      Barcode: {{this.barcode}}{{#if this.servingSize}} · {{this.servingSize}}{{this.servingUnit}}{{/if}}
    </div>

    <!-- Dietary Tags -->
    {{#if this.dietaryTags.length}}
      <div class="flex flex-wrap gap-1.5 mt-3">
        {{#each this.dietaryTags}}
          <span class="text-[11px] font-medium px-2 py-0.5 bg-slate-100 text-slate-700 rounded-md border border-slate-200/60">
            {{this}}
          </span>
        {{/each}}
      </div>
    {{/if}}

    <!-- Declared Ingredients Snippet -->
    {{#if this.ingredients.length}}
      <div class="mt-3.5 pt-3 border-t border-slate-100 text-xs text-slate-600 line-clamp-2">
        <span class="font-semibold text-slate-800">Ingredients:</span>
        {{#each this.ingredients}}
          <span class="{{#if this.isAllergen}}text-rose-700 font-semibold{{/if}}">{{this.name}}{{#unless @last}}, {{/unless}}</span>
        {{/each}}
      </div>
    {{/if}}
  </div>

  <!-- Card Action -->
  <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
    <a
      href="/catalog/product/{{this.id}}"
      class="text-xs font-semibold text-slate-900 hover:text-emerald-800 transition-colors underline"
    >
      Inspect food details
    </a>
    {{#if this.nutritionFacts.length}}
      <span class="text-[11px] font-mono text-slate-400">
        {{this.nutritionFacts.length}} facts
      </span>
    {{/if}}
  </div>
</div>
