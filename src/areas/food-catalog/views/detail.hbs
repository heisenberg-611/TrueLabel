<div class="space-y-6">

  {{#if success}}
    <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 text-xs font-semibold text-emerald-900 dark:text-emerald-200 flex items-center justify-between shadow-sm">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
        <span>{{success}}</span>
      </div>
    </div>
  {{/if}}

  {{#if error}}
    <div class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-800 text-xs font-semibold text-rose-900 dark:text-rose-200 flex items-center justify-between shadow-sm">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-rose-600 dark:text-rose-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        <span>{{error}}</span>
      </div>
    </div>
  {{/if}}

  <!-- Administrative Governance Action Ribbon (Admin Only) -->
  {{#if (eq user.role 'admin')}}
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 sm:p-5 text-slate-900 dark:text-slate-100 flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-sm">
      <div class="space-y-1">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-[11px] font-mono px-2.5 py-0.5 rounded bg-slate-900 text-white dark:bg-slate-100 dark:text-slate-900 font-bold shadow-sm">Admin governance mode</span>
          <span class="text-xs font-mono text-slate-500 dark:text-slate-400 font-medium">ID: #{{product.id}}</span>
          {{#if (eq product.status 'banned')}}
            <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-rose-50 text-rose-800 border border-rose-200 dark:bg-rose-950/60 dark:text-rose-300 dark:border-rose-800">Status: Banned</span>
          {{else if (eq product.status 'archived')}}
            <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-amber-50 text-amber-800 border border-amber-200 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800">Status: Archived</span>
          {{else}}
            <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800">Status: Active</span>
          {{/if}}
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400">Authorized administrative override for this catalog entity.</p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <a
          href="/admin/rules"
          class="min-h-[44px] inline-flex items-center px-3 py-1.5 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-lg text-xs font-semibold transition-colors border border-slate-300 dark:border-slate-700 shadow-sm"
        >
          Food rule base
        </a>
        <a
          href="/admin/scoring"
          class="min-h-[44px] inline-flex items-center px-3 py-1.5 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-lg text-xs font-semibold transition-colors border border-slate-300 dark:border-slate-700 shadow-sm"
        >
          Scoring weights
        </a>
        <a
          href="/catalog/manage/{{product.id}}/edit"
          class="min-h-[44px] inline-flex items-center px-3 py-1.5 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 rounded-lg text-xs font-semibold transition-colors border border-slate-300 dark:border-slate-700 shadow-sm"
        >
          Edit details
        </a>

        {{#if (eq product.status 'banned')}}
          <form method="POST" action="/catalog/manage/{{product.id}}/unban" class="inline">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button
              type="submit"
              onclick="return confirm('Reinstate this food product to active catalog status?');"
              class="min-h-[44px] px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-semibold transition-colors shadow-sm"
            >
              Reinstate product
            </button>
          </form>
        {{else}}
          <button
            type="button"
            onclick="openBanProductModal()"
            class="min-h-[44px] px-3 py-1.5 bg-rose-700 hover:bg-rose-800 text-white rounded-lg text-xs font-semibold transition-colors shadow-sm inline-flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
            Ban food item
          </button>
        {{/if}}

        {{#if (ne product.status 'archived')}}
          <form method="POST" action="/catalog/manage/{{product.id}}/archive" class="inline">
            <input type="hidden" name="_csrf" value="{{csrfToken}}">
            <button
              type="submit"
              onclick="return confirm('Archive this food product? It will be hidden from consumer discovery.');"
              class="min-h-[44px] px-3 py-1.5 bg-white dark:bg-slate-800 hover:bg-amber-50 dark:hover:bg-amber-950/40 text-slate-700 hover:text-amber-800 dark:text-slate-300 dark:hover:text-amber-300 rounded-lg text-xs font-semibold transition-colors border border-slate-300 dark:border-slate-700 hover:border-amber-300 shadow-sm"
            >
              Archive
            </button>
          </form>
        {{/if}}

        <button
          type="button"
          onclick="openDeleteProductModal()"
          class="min-h-[44px] px-3 py-1.5 bg-white dark:bg-slate-800 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-slate-700 hover:text-rose-700 dark:text-slate-300 dark:hover:text-rose-400 border border-slate-300 dark:border-slate-700 hover:border-rose-300 dark:hover:border-rose-800 rounded-lg text-xs font-semibold transition-colors shadow-sm"
        >
          Permanently delete
        </button>
      </div>
    </div>
  {{/if}}

  <!-- Regulatory Health & Safety Ban Docket (Displayed when product is banned) -->
  {{#if (eq product.status 'banned')}}
    <div class="bg-rose-950 border-2 border-rose-700 rounded-xl p-6 sm:p-7 text-rose-100 space-y-4 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-rose-800/80 pb-4">
        <div class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-lg bg-rose-800 text-white flex items-center justify-center font-black text-lg flex-shrink-0">
            !
          </span>
          <div>
            <span class="text-[11px] font-mono font-bold tracking-wide text-rose-300 block">Statutory recall &amp; safety advisory</span>
            <h2 class="text-lg font-black text-white tracking-tight">Product formulation banned from circulation</h2>
          </div>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-rose-900/80 border border-rose-700 text-xs font-mono text-rose-200">
          <span>Barcode:</span>
          <strong>{{product.barcode}}</strong>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="md:col-span-2 space-y-2">
          <span class="font-semibold text-rose-300 block">Formal regulatory violation / ban rationale:</span>
          <div class="bg-rose-900/40 border border-rose-800 rounded-lg p-3.5 text-rose-100 font-medium leading-relaxed">
            {{#if product.banReason}}
              {{product.banReason}}
            {{else}}
              Product failed statutory food safety and label verification compliance standards.
            {{/if}}
          </div>
          <p class="text-[11px] text-rose-300 leading-normal">
            Consumers holding packaging with this barcode are instructed not to ingest this item. Commercial retail sale or redistribution is prohibited under food safety directives.
          </p>
        </div>

        <div class="bg-rose-900/30 border border-rose-800/60 rounded-lg p-3.5 space-y-2 text-xs">
          <span class="font-semibold text-rose-300 block">Quarantine record</span>
          <div class="space-y-1 text-[11px] text-rose-200">
            <div>Status: <strong class="text-white">Statutory Quarantine</strong></div>
            {{#if product.bannedAt}}
              <div>Action date: <strong class="text-white font-mono">{{product.bannedAt}}</strong></div>
            {{/if}}
            <div>Issuing body: <strong class="text-white">TrueLabel Food Safety Directorate</strong></div>
          </div>
          {{#if (eq user.role 'admin')}}
            <div class="pt-2">
              <form method="POST" action="/catalog/manage/{{product.id}}/unban">
                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                <button
                  type="submit"
                  class="w-full min-h-[44px] text-center px-3 py-1.5 bg-rose-800 hover:bg-rose-700 text-white rounded text-xs font-semibold transition-colors"
                >
                  Reinstate product formulation
                </button>
              </form>
            </div>
          {{/if}}
        </div>
      </div>
    </div>
  {{/if}}

  <!-- Breadcrumb & Actions Bar -->
  <div class="flex flex-wrap items-center justify-between gap-2">
    <a href="/catalog" class="inline-flex items-center min-h-[44px] text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
      &larr; Back to food catalog
    </a>
    <div class="flex items-center gap-3">
      {{#if isOwner}}
        <a href="/catalog/manage/{{product.id}}/edit" class="min-h-[44px] inline-flex items-center text-xs font-semibold px-3 py-1.5 rounded-md border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors">
          Edit food details
        </a>
      {{/if}}
      <span class="text-xs font-mono text-slate-400">Barcode: {{product.barcode}}</span>
    </div>
  </div>

  <!-- Main Product Header: Editorial Dossier Hero -->
  <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 sm:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
    <div class="space-y-2">
      <div class="text-xs font-semibold text-slate-500 dark:text-slate-400">
        <span class="text-slate-900 dark:text-slate-100 font-bold">{{product.brand}}</span> &bull; <span>{{product.category}}</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">{{product.name}}</h1>
      {{#if product.description}}
        <p class="text-sm text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">{{product.description}}</p>
      {{/if}}
      
      <!-- Dietary Tags -->
      {{#if product.dietaryTags.length}}
        <div class="flex flex-wrap gap-1.5 pt-1">
          {{#each product.dietaryTags}}
            <span class="text-xs font-semibold px-2.5 py-1 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 rounded-md">
              {{this}}
            </span>
          {{/each}}
        </div>
      {{/if}}
    </div>

    <!-- Explainable Food Quality Score Seal -->
    <div class="flex flex-col items-center justify-center p-5 rounded-xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 text-center min-w-[185px] self-stretch md:self-auto">
      <span class="text-xs font-medium text-slate-500 dark:text-slate-400">Quality score</span>
      <div class="text-4xl font-black mt-1 font-mono {{#if (gte product.qualityScore 80)}}text-emerald-800 dark:text-emerald-400{{else}}{{#if (gte product.qualityScore 60)}}text-amber-800 dark:text-amber-400{{else}}text-rose-800 dark:text-rose-400{{/if}}{{/if}}">
        {{product.qualityScore}}<span class="text-base text-slate-400 font-normal font-sans">/100</span>
      </div>
      <div class="text-xs font-semibold mt-1 {{#if (gte product.qualityScore 80)}}text-emerald-800 dark:text-emerald-300{{else}}{{#if (gte product.qualityScore 60)}}text-amber-800 dark:text-amber-300{{else}}text-rose-800 dark:text-rose-400{{/if}}{{/if}}">
        {{#if (gte product.qualityScore 80)}}Tier 1: High transparency{{else}}{{#if (gte product.qualityScore 60)}}Tier 2: Moderate quality{{else}}Tier 3: Elevated processing{{/if}}{{/if}}
      </div>
      {{#if scoreBreakdown}}
        {{#if scoreBreakdown.isProvisional}}
          <span class="text-[11px] font-semibold text-amber-700 dark:text-amber-300 mt-1">Provisional components active</span>
        {{else}}
          <span class="text-[11px] font-semibold text-emerald-700 dark:text-emerald-300 mt-1">All 5 signals verified</span>
        {{/if}}
      {{else}}
        <span class="text-[11px] text-slate-400 mt-0.5">Rule-based quality score</span>
      {{/if}}
    </div>
  </div>

  <!-- FEATURE F16: Personalized Health & Allergen Conflict Engine (Consumers Only) -->
  {{#if (eq user.role 'consumer')}}
    {{#if conflictEvaluation.profileConfigured}}
      {{#if conflictEvaluation.hasAllergenConflict}}
        <div class="bg-rose-50 dark:bg-rose-950/40 border-2 border-rose-600 rounded-xl p-5 space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-rose-600 text-white flex items-center justify-center font-bold text-xs">!</span>
              <h3 class="text-sm font-bold text-rose-950 dark:text-rose-200">Critical allergen conflict detected</h3>
            </div>
            <a href="/personal/profile" class="text-xs font-semibold text-rose-800 dark:text-rose-300 hover:text-rose-950 underline">Edit profile</a>
          </div>
          <p class="text-xs text-rose-900 dark:text-rose-200 leading-relaxed">
            This food product contains declared ingredients that conflict with your saved allergy profile:
          </p>
          <div class="space-y-1.5">
            {{#each conflictEvaluation.conflicts}}
              {{#if (eq this.category "allergen")}}
                <div class="p-2.5 rounded-lg bg-white dark:bg-slate-900 border border-rose-300 dark:border-rose-800 text-xs flex items-start gap-2">
                  <span class="font-bold text-rose-700 dark:text-rose-300 text-[11px] px-1.5 py-0.5 bg-rose-100 dark:bg-rose-950 rounded">Match</span>
                  <div>
                    <span class="font-bold text-rose-950 dark:text-rose-200">{{this.title}}</span>
                    <span class="block text-slate-700 dark:text-slate-300 text-[11px] mt-0.5">{{this.description}}</span>
                  </div>
                </div>
              {{/if}}
            {{/each}}
          </div>
        </div>
      {{/if}}

      {{#if conflictEvaluation.hasDietaryConflict}}
        <div class="bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-800 rounded-xl p-4 space-y-2">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold text-amber-950 dark:text-amber-200">Dietary lifestyle conflict</h4>
            <a href="/personal/profile" class="text-xs font-semibold text-amber-800 dark:text-amber-300 hover:text-amber-950 underline">Edit profile</a>
          </div>
          {{#each conflictEvaluation.conflicts}}
            {{#if (eq this.category "dietary")}}
              <p class="text-xs text-amber-900 dark:text-amber-200">{{this.description}}</p>
            {{/if}}
          {{/each}}
        </div>
      {{/if}}

      {{#if conflictEvaluation.hasNutritionWarning}}
        <div class="bg-blue-50 dark:bg-blue-950/40 border border-blue-200 dark:border-blue-800 rounded-xl p-3.5 text-xs text-blue-900 dark:text-blue-200 flex items-start gap-2">
          <span class="text-blue-700 dark:text-blue-400 font-bold">Note:</span>
          <div>
            <span class="font-semibold">Nutritional target threshold:</span>
            {{#each conflictEvaluation.conflicts}}
              {{#if (eq this.category "nutrition")}}
                <span class="block text-[11px] text-blue-800 dark:text-blue-300 mt-0.5">{{this.description}}</span>
              {{/if}}
            {{/each}}
          </div>
        </div>
      {{/if}}

      {{#if conflictEvaluation.isSafeForUser}}
        <div class="bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 rounded-xl p-4 flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 bg-emerald-700 text-white rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0">✓</div>
            <div>
              <h4 class="text-xs font-bold text-emerald-950 dark:text-emerald-200">Clear for your dietary profile</h4>
              <p class="text-xs text-emerald-800 dark:text-emerald-300 mt-0.5">
                No declared allergens or dietary restrictions from your profile ({{#each userProfile.allergies}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{#if userProfile.dietaryPreferences.length}} &bull; {{#each userProfile.dietaryPreferences}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}) were flagged in this product.
              </p>
            </div>
          </div>
          <a href="/personal/profile" class="text-xs font-semibold text-emerald-800 dark:text-emerald-300 hover:text-emerald-950 underline flex-shrink-0">My profile</a>
        </div>
      {{/if}}

    {{else}}
      <!-- Profile Not Configured Callout -->
      <div class="bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <div class="text-xs font-bold text-slate-800 dark:text-slate-100">Personalize your allergen safety shield</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Configure your allergy and dietary preferences to see real-time automated conflict warnings.</div>
        </div>
        <a href="/personal/profile" class="min-h-[44px] inline-flex items-center justify-center px-3.5 py-2 bg-slate-900 dark:bg-slate-100 dark:text-slate-900 hover:bg-slate-800 text-white font-semibold text-xs rounded-lg text-center flex-shrink-0 transition-colors">
          Configure profile
        </a>
      </div>
    {{/if}}
  {{/if}}

  <!-- Allergen Warning Banner (If allergens declared) -->
  {{#if allergens.length}}
    <div class="bg-rose-50 dark:bg-rose-950/40 border-2 border-rose-300 dark:border-rose-800 rounded-xl p-4 flex items-start gap-3">
      <div class="w-6 h-6 bg-rose-600 text-white rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">!</div>
      <div>
        <h4 class="text-sm font-bold text-rose-900 dark:text-rose-200">Declared allergen notice</h4>
        <p class="text-xs text-rose-800 dark:text-rose-300 mt-0.5">This food product contains declared allergens: 
          {{#each allergens}}
            <span class="font-semibold underline">{{this.name}} ({{this.allergenType}})</span>{{#unless @last}}, {{/unless}}
          {{/each}}.
        </p>
      </div>
    </div>
  {{/if}}

  <!-- FEATURE F04: Explainable 5-Component Food Quality Score Breakdown & History -->
  {{#if scoreBreakdown}}
    <section class="bg-white dark:bg-[#141413] border border-slate-200 dark:border-white/10 rounded-xl p-6 space-y-5 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 border-b border-slate-100 dark:border-slate-800 pb-4">
        <div class="space-y-1">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-base font-black text-slate-950 dark:text-white tracking-tight">
              Explainable Food Quality Score Breakdown
            </h2>
            {{#if scoreBreakdown.isProvisional}}
              <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-amber-50 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                Includes provisional baseline
              </span>
            {{else}}
              <span class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                100% verified signals
              </span>
            {{/if}}
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed max-w-3xl">
            Deterministic 0–100 score computed from five weighted signals totaling
            <strong class="font-mono text-slate-800 dark:text-slate-200">{{scoreBreakdown.rawWeightedScore}} / 100</strong>
            using active formula weights ({{scoreBreakdown.weights.ingredientWeight}}% / {{scoreBreakdown.weights.nutritionWeight}}% / {{scoreBreakdown.weights.verificationWeight}}% / {{scoreBreakdown.weights.recallWeight}}% / {{scoreBreakdown.weights.communityWeight}}%).
          </p>
        </div>

        {{#if (eq user.role 'admin')}}
          <a
            href="/admin/scoring"
            class="min-h-[44px] inline-flex items-center px-3.5 py-2 rounded-lg border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors shrink-0"
          >
            Configure weights &rarr;
          </a>
        {{/if}}
      </div>

      {{#if scoreBreakdown.quarantineCapApplied}}
        <div class="p-3.5 rounded-lg bg-rose-50 dark:bg-rose-950/40 border border-rose-300 dark:border-rose-800 text-xs text-rose-900 dark:text-rose-200 flex items-start gap-2.5">
          <span class="w-5 h-5 rounded bg-rose-700 text-white font-bold text-[11px] flex items-center justify-center shrink-0 mt-0.5">!</span>
          <div>
            <strong class="font-bold">Statutory quarantine score cap applied:</strong>
            Raw formulation score was {{scoreBreakdown.rawWeightedScore}}/100, capped at <strong>35/100</strong> because this item is under an active regulatory ban.
          </div>
        </div>
      {{/if}}

      {{#if scoreBreakdown.isProvisional}}
        <div class="p-3.5 rounded-lg bg-amber-50/80 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/80 text-xs text-amber-950 dark:text-amber-200 flex items-start gap-2.5">
          <span class="px-1.5 py-0.5 rounded bg-amber-200/80 dark:bg-amber-900 text-amber-900 dark:text-amber-200 font-mono font-bold text-[10px] uppercase shrink-0 mt-0.5">Provisional</span>
          <p class="leading-relaxed text-[11px] sm:text-xs">
            {{scoreBreakdown.provisionalDisclaimer}} Provisional components are transparently marked below and never presented as fully verified facts.
          </p>
        </div>
      {{/if}}

      <!-- 5 Weighted Score Component Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-3.5">
        {{#each scoreBreakdown.components}}
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900/60 flex flex-col justify-between gap-3">
            <div class="space-y-2">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <span class="text-[11px] font-mono font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wide block">
                    Weight {{this.weight}}%
                  </span>
                  <h3 class="text-xs font-extrabold text-slate-900 dark:text-slate-100 leading-snug mt-0.5">
                    {{this.label}}
                  </h3>
                </div>
                {{#if this.provisional}}
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-800 shrink-0">
                    Provisional
                  </span>
                {{else}}
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800 shrink-0">
                    Verified
                  </span>
                {{/if}}
              </div>

              <div class="flex items-baseline justify-between gap-2 pt-1">
                <div class="text-2xl font-black font-mono text-slate-950 dark:text-white">
                  {{this.score}}<span class="text-xs font-normal text-slate-400">/100</span>
                </div>
                <span class="text-[11px] font-mono font-bold text-emerald-700 dark:text-emerald-400">
                  +{{this.weightedContributionFormatted}} pts
                </span>
              </div>

              <div class="w-full h-1.5 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
                <div class="h-full {{this.barColorClass}}" style="width: {{this.score}}%;"></div>
              </div>

              <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed pt-1">
                {{this.rationale}}
              </p>
              {{#if this.provisionalNote}}
                <p class="text-[10px] text-amber-800 dark:text-amber-300 leading-snug bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900 rounded px-2 py-1">
                  {{this.provisionalNote}}
                </p>
              {{/if}}
            </div>

            <div class="pt-2 border-t border-slate-200/80 dark:border-slate-800 text-[10px] font-mono text-slate-500 dark:text-slate-400 truncate" title="{{this.evidenceSummary}}">
              {{this.evidenceSummary}}
            </div>
          </div>
        {{/each}}
      </div>

      <!-- Score History Snapshot Timeline -->
      {{#if scoreHistory.length}}
        <div class="pt-4 border-t border-slate-100 dark:border-slate-800 space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-xs font-bold text-slate-800 dark:text-slate-200">
              Score history &amp; audit trail ({{scoreHistory.length}} recorded {{#if (eq scoreHistory.length 1)}}snapshot{{else}}snapshots{{/if}})
            </h3>
            <span class="text-[11px] font-mono text-slate-400">Reproducible snapshots</span>
          </div>

          <div class="overflow-x-auto border border-slate-200 dark:border-slate-800 rounded-lg">
            <table class="w-full text-left border-collapse text-xs">
              <thead class="bg-slate-50 dark:bg-slate-900 text-[11px] text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800">
                <tr>
                  <th class="px-3 py-2 font-semibold">Date</th>
                  <th class="px-3 py-2 font-semibold">Score</th>
                  <th class="px-3 py-2 font-semibold">Trigger</th>
                  <th class="px-3 py-2 font-semibold">Component scores</th>
                  <th class="px-3 py-2 font-semibold">Weights</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800 bg-white dark:bg-slate-950/40">
                {{#each scoreHistory}}
                  <tr>
                    <td class="px-3 py-2 font-mono text-[11px] text-slate-600 dark:text-slate-300 whitespace-nowrap">
                      {{this.recordedOn}}
                    </td>
                    <td class="px-3 py-2 font-mono font-bold whitespace-nowrap">
                      <span class="{{#if (gte this.totalScore 80)}}text-emerald-700 dark:text-emerald-400{{else}}{{#if (gte this.totalScore 60)}}text-amber-700 dark:text-amber-400{{else}}text-rose-700 dark:text-rose-400{{/if}}{{/if}}">
                        {{this.totalScore}}/100
                      </span>
                      {{#if this.deltaLabel}}
                        <span class="ml-1 text-[10px] {{#if this.deltaPositive}}text-emerald-600 dark:text-emerald-400{{else}}{{#if this.deltaNegative}}text-rose-600 dark:text-rose-400{{else}}text-slate-400{{/if}}{{/if}}">
                          ({{this.deltaLabel}})
                        </span>
                      {{/if}}
                    </td>
                    <td class="px-3 py-2 text-slate-700 dark:text-slate-200 whitespace-nowrap">
                      {{this.triggerLabel}}
                      {{#if this.isProvisional}}
                        <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded bg-amber-50 dark:bg-amber-950 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800">Provisional</span>
                      {{/if}}
                    </td>
                    <td class="px-3 py-2 font-mono text-[11px] text-slate-500 dark:text-slate-400 whitespace-nowrap">
                      {{this.componentSummary}}
                    </td>
                    <td class="px-3 py-2 font-mono text-[11px] text-slate-500 dark:text-slate-400 whitespace-nowrap">
                      {{this.weightsLabel}}
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      {{/if}}
    </section>
  {{/if}}

  <!-- Feature F11 & F13: Community Reviews Summary & Safety Reporting -->
  <section class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-6 space-y-5">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 dark:border-slate-800 pb-4">
      <div class="space-y-1">
        <h2 class="text-base font-bold text-slate-950 dark:text-white">Consumer reviews and safety reports</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Credibility-weighted ratings from verified accounts (informing the Community component of the Food Quality Score) and private safety reporting.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href="/community/products/{{product.id}}/reviews"
          class="min-h-[44px] inline-flex items-center px-4 py-2 bg-slate-900 dark:bg-slate-100 dark:text-slate-900 hover:bg-slate-800 text-white rounded-lg font-semibold text-xs transition-colors"
        >
          {{#if reviewSummary.reviewCount}}Read all {{reviewSummary.reviewCount}} reviews{{else}}Write the first review{{/if}}
        </a>
        {{#if (eq user.role 'consumer')}}
          <a
            href="/community/products/{{product.id}}/report"
            class="min-h-[44px] inline-flex items-center px-4 py-2 border border-rose-300 dark:border-rose-800 bg-rose-50 dark:bg-rose-950/40 hover:bg-rose-100 text-rose-800 dark:text-rose-300 rounded-lg font-semibold text-xs transition-colors"
          >
            Report a product issue
          </a>
        {{/if}}
      </div>
    </div>

    {{#if reviewSummary.reviewCount}}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Aggregate & Dimension Summary -->
        <div class="lg:col-span-5 space-y-3">
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-black font-mono text-slate-950 dark:text-white">{{reviewSummary.averageRating}}</span>
            <span class="text-xs font-mono text-slate-500 dark:text-slate-400">/ 5.0 weighted average ({{reviewSummary.reviewCount}} {{#if (eq reviewSummary.reviewCount 1)}}review{{else}}reviews{{/if}})</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
            {{#each reviewSummary.dimensionAverages}}
              <div class="bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 rounded-md px-3 py-2">
                <span class="text-slate-500 dark:text-slate-400 block text-[11px]">{{this.label}}</span>
                <span class="font-mono font-bold text-slate-900 dark:text-slate-100">{{this.score}} / 5</span>
              </div>
            {{/each}}
          </div>
        </div>

        <!-- Recent Review Excerpts -->
        <div class="lg:col-span-7 divide-y divide-slate-100 dark:divide-slate-800 border border-slate-100 dark:border-slate-800 rounded-lg bg-slate-50/50 dark:bg-slate-800/30">
          {{#each reviewSummary.recentReviews}}
            <div class="p-4 space-y-1">
              <div class="flex items-center justify-between gap-2 text-xs">
                <span class="font-bold text-slate-900 dark:text-slate-100">{{this.authorName}} <span class="font-mono font-normal text-slate-500 ml-1">({{this.weightFormatted}})</span></span>
                <span class="font-mono font-bold text-emerald-800 dark:text-emerald-400">{{this.rating}} / 5</span>
              </div>
              {{#if this.title}}
                <div class="text-xs font-semibold text-slate-800 dark:text-slate-200">{{this.title}}</div>
              {{/if}}
              <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed">{{this.comment}}</p>
            </div>
          {{/each}}
        </div>
      </div>
    {{else}}
      <div class="text-xs text-slate-500 dark:text-slate-400">
        No consumer reviews recorded yet. Consumers can share structured ratings on taste, label accuracy, packaging condition, and purchase experience.
      </div>
    {{/if}}
  </section>

  <!-- Detailed Inspection: Nutrition Panel vs Rule-Based Ingredient Transparency -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- LEFT: FDA/EU Style Authentic Nutrition Facts Box (5 cols) with Dynamic Serving Scaler -->
    <div class="lg:col-span-5 bg-white dark:bg-[#141413] p-6 border border-slate-200 dark:border-white/10 rounded-xl shadow-sm serving-scaler-container" data-base-serving="{{#if product.servingSize}}{{product.servingSize}}{{else}}100{{/if}}" data-serving-unit="{{#if product.servingUnit}}{{product.servingUnit}}{{else}}g{{/if}}">
      
      <!-- Interactive Modern Portion Scaler (Fontsight & Modern Slider Mechanics) -->
      <div class="mb-5 p-4 bg-gradient-to-br from-slate-50 to-emerald-50/30 dark:from-slate-800/80 dark:to-emerald-950/20 rounded-2xl border border-slate-200/90 dark:border-white/10 shadow-sm space-y-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">
              Interactive Portion Scaler
            </span>
          </div>
          <div class="flex items-baseline gap-1 bg-white dark:bg-slate-900 px-3 py-1 rounded-lg border border-slate-200 dark:border-slate-700 shadow-xs">
            <span data-serving-display class="font-mono text-emerald-700 dark:text-emerald-400 font-black text-base">{{product.servingSize}}{{product.servingUnit}}</span>
          </div>
        </div>

        <!-- Modern Slider Track with Custom Pointer -->
        <div class="relative py-1">
          <input
            type="range"
            data-serving-slider
            data-a90-cursor="scale"
            min="10"
            max="250"
            step="5"
            value="{{#if product.servingSize}}{{product.servingSize}}{{else}}100{{/if}}"
            class="serving-slider w-full"
            aria-label="Adjust serving size"
          />
        </div>

        <!-- Modern Clickable Preset Chips with Pointer Cursor (Touch-Friendly) -->
        <div class="flex flex-wrap items-center justify-between gap-1.5 pt-0.5">
          <button type="button" data-preset-val="25" class="serving-preset-btn min-h-[44px] px-3 py-1.5 rounded-md text-[10px] font-mono font-bold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 cursor-pointer transition-all flex items-center justify-center">
            25g
          </button>
          <button type="button" data-preset-val="50" class="serving-preset-btn min-h-[44px] px-3 py-1.5 rounded-md text-[10px] font-mono font-bold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 cursor-pointer transition-all flex items-center justify-center">
            50g
          </button>
          <button type="button" data-preset-val="100" class="serving-preset-btn min-h-[44px] px-3 py-1.5 rounded-md text-[10px] font-mono font-bold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 cursor-pointer transition-all flex items-center justify-center">
            100g (Std)
          </button>
          <button type="button" data-preset-val="150" class="serving-preset-btn min-h-[44px] px-3 py-1.5 rounded-md text-[10px] font-mono font-bold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 cursor-pointer transition-all flex items-center justify-center">
            150g
          </button>
          <button type="button" data-preset-val="250" class="serving-preset-btn min-h-[44px] px-3 py-1.5 rounded-md text-[10px] font-mono font-bold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-emerald-500 hover:text-emerald-700 dark:hover:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 cursor-pointer transition-all flex items-center justify-center">
            250g
          </button>
        </div>
      </div>

      <div class="nutrition-panel mx-auto">
        <h3>Nutrition Facts</h3>
        
        <div class="nutrition-serving-header">
          <div class="text-sm font-bold text-slate-900 dark:text-slate-100">
            Serving size: <span data-serving-display class="font-mono text-emerald-700 dark:text-emerald-400 font-extrabold">{{product.servingSize}}{{product.servingUnit}}</span>
          </div>
          <div class="text-xs text-slate-500 font-normal">
            Amounts scaled dynamically for <span data-serving-display class="font-mono font-semibold">{{product.servingSize}}{{product.servingUnit}}</span> portion
          </div>
        </div>

        <div class="nutrition-calories-row" data-base-nutrient="Energy" data-base-val="{{#each product.nutritionFacts}}{{#if (eq this.nutrient 'Energy')}}{{this.amountPer100g}}{{/if}}{{/each}}" data-base-unit="kcal" data-dv-daily="2000">
          <div>
            <div class="text-xs font-bold uppercase tracking-tight">Energy / Calories</div>
            <div class="text-[11px] text-slate-500 font-medium">Per <span data-serving-display>{{product.servingSize}}{{product.servingUnit}}</span> portion</div>
          </div>
          <div class="nutrition-calories-number font-mono">
            <span data-val-display>
              {{#each product.nutritionFacts}}
                {{#if (eq this.nutrient "Energy")}}{{this.amountPer100g}}{{/if}}
              {{/each}}
            </span>
            <span class="text-sm font-bold font-sans">kcal</span>
          </div>
        </div>

        <!-- Nutrition Facts Breakdown with Waterfall Progress Bars -->
        <div class="space-y-1.5 text-xs pt-1">
          {{#each product.nutritionFacts}}
            {{#unless (eq this.nutrient "Energy")}}
              <div
                class="nutrition-row {{#if (or (eq this.nutrient 'Saturated Fat') (eq this.nutrient 'Sugars'))}}indent{{/if}}"
                data-base-nutrient="{{this.nutrient}}"
                data-base-val="{{this.amountPer100g}}"
                data-base-unit="{{this.unit}}"
                data-dv-daily="{{#if (eq this.nutrient 'Fat')}}78{{else}}{{#if (eq this.nutrient 'Saturated Fat')}}20{{else}}{{#if (eq this.nutrient 'Carbohydrates')}}275{{else}}{{#if (eq this.nutrient 'Sugars')}}50{{else}}{{#if (eq this.nutrient 'Protein')}}50{{else}}{{#if (eq this.nutrient 'Salt')}}6{{else}}100{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}{{/if}}"
              >
                <div class="flex-grow pr-2">
                  <div class="flex items-center justify-between mb-1">
                    <span class="{{#if (or (eq this.nutrient 'Fat') (eq this.nutrient 'Carbohydrates') (eq this.nutrient 'Protein') (eq this.nutrient 'Salt'))}}font-bold{{else}}text-slate-700 dark:text-slate-300{{/if}}">
                      {{this.nutrient}}
                    </span>
                    <span class="font-mono font-semibold" data-val-display>
                      {{this.amountPer100g}}{{this.unit}}
                    </span>
                  </div>
                  <!-- Fontsight-inspired Waterfall Progress Track -->
                  <div class="nutrition-waterfall-track">
                    <div class="nutrition-waterfall-fill bg-emerald-600" style="width: 25%;"></div>
                  </div>
                </div>
                <div class="font-mono font-bold text-right pl-2 w-12 text-slate-500" data-dv-display>
                  --%
                </div>
              </div>
            {{/unless}}
          {{/each}}
        </div>

        <div class="mt-4 pt-2 border-t-2 border-slate-900 dark:border-white/20 text-[10px] text-slate-500 leading-tight">
          * Dynamic Daily Values (% DV) based on a 2,000 calorie reference diet. Recalculated in real-time.
        </div>
      </div>
    </div>

    <!-- RIGHT: Feature F03 Rule-Based Ingredient, Additive & Allergen Analysis (7 cols) -->
    <div class="lg:col-span-7 space-y-6">

      <!-- Rule-Based Ingredient Analysis & Coverage Header -->
      <section class="bg-white dark:bg-[#141413] border border-slate-200 dark:border-white/10 rounded-xl p-5 sm:p-6 shadow-sm space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 border-b border-slate-100 dark:border-slate-800 pb-4">
          <div class="space-y-1">
            <h2 class="text-base font-black text-slate-900 dark:text-white tracking-tight">
              Ingredient, additive &amp; allergen analysis
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 max-w-xl leading-relaxed">
              Evaluated item-by-item against TrueLabel's admin-maintained food rule base. Hover or tap any ingredient to inspect FDA/EU status and copy citations.
            </p>
          </div>
          {{#if (eq user.role 'admin')}}
            <a
              href="/admin/rules"
              class="min-h-[44px] inline-flex items-center px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors shrink-0"
            >
              Manage food rules
            </a>
          {{/if}}
        </div>

        {{#if ingredientAnalysis.totalCount}}
          <!-- Rule Coverage Telemetry Bar -->
          <div class="p-3.5 rounded-lg bg-slate-50 dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 space-y-2.5">
            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
              <span class="font-semibold text-slate-800 dark:text-slate-200">
                Rule base coverage:
                <strong class="font-mono text-slate-950 dark:text-white">{{ingredientAnalysis.counts.recognized}} / {{ingredientAnalysis.counts.total}}</strong>
                matched (<span class="font-mono">{{ingredientAnalysis.counts.coveragePercent}}%</span>)
              </span>
              <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono">
                <span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">
                  {{ingredientAnalysis.counts.safe}} safe
                </span>
                <span class="px-2 py-0.5 rounded bg-amber-50 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                  {{ingredientAnalysis.counts.caution}} caution
                </span>
                {{#if ingredientAnalysis.counts.warning}}
                  <span class="px-2 py-0.5 rounded bg-rose-50 dark:bg-rose-950/60 text-rose-800 dark:text-rose-300 border border-rose-200 dark:border-rose-800">
                    {{ingredientAnalysis.counts.warning}} warning
                  </span>
                {{/if}}
                {{#if ingredientAnalysis.counts.unknown}}
                  <span class="px-2 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-indigo-300 border border-slate-400 dark:border-indigo-700 font-bold">
                    {{ingredientAnalysis.counts.unknown}} unknown
                  </span>
                {{/if}}
              </div>
            </div>

            <div class="w-full h-2 rounded-full bg-slate-200 dark:bg-slate-800 overflow-hidden">
              <div
                class="h-full bg-emerald-600 dark:bg-emerald-500 transition-all"
                style="width: {{ingredientAnalysis.counts.coveragePercent}}%;"
              ></div>
            </div>
          </div>

          {{#if ingredientAnalysis.categoryNotes.length}}
            <div class="p-3.5 rounded-lg bg-amber-50 dark:bg-amber-950/40 border border-amber-300 dark:border-amber-800 space-y-1.5 text-xs">
              <div class="font-bold text-amber-950 dark:text-amber-200">Category-specific rules applied ({{product.category}})</div>
              <ul class="space-y-1 text-amber-900 dark:text-amber-300 text-[11px] leading-relaxed list-disc pl-4">
                {{#each ingredientAnalysis.categoryNotes}}
                  <li>{{this}}</li>
                {{/each}}
              </ul>
            </div>
          {{/if}}

          <!-- PART A: Rule-Verified Ingredients & Additives -->
          <div class="space-y-2.5">
            <div class="flex items-center justify-between">
              <h3 class="text-xs font-bold text-slate-700 dark:text-slate-300">
                Rule-verified ingredients &amp; additives ({{ingredientAnalysis.recognizedIngredients.length}})
              </h3>
            </div>

            {{#if ingredientAnalysis.recognizedIngredients.length}}
              <div class="space-y-2">
                {{#each ingredientAnalysis.recognizedIngredients}}
                  <div
                    data-inspectable-ingredient
                    data-ingredient-name="{{this.name}}{{#if this.additiveCode}} ({{this.additiveCode}}){{/if}}"
                    data-hazard="{{this.hazardLevel}}"
                    data-hazard-detail="{{this.explanation}}"
                    data-fda-status="{{this.fdaStatus}}"
                    data-eu-status="{{this.euStatus}}"
                    data-rule-source="{{this.ruleSource}}"
                    data-allergen="{{#if this.isAllergen}}{{this.allergenType}}{{else}}false{{/if}}"
                    data-citation="TrueLabel F03 Rule Dossier — {{this.name}}: {{this.explanation}} [Source: {{this.ruleSource}}]"
                    class="cursor-help p-3.5 rounded-lg border-l-4 border {{#if this.isWarning}}border-l-rose-600 bg-rose-50/70 dark:bg-rose-950/30 border-rose-200 dark:border-rose-900{{else}}{{#if this.isCaution}}border-l-amber-600 bg-amber-50/70 dark:bg-amber-950/30 border-amber-200 dark:border-amber-900{{else}}{{#if this.isAllergen}}border-l-rose-500 bg-rose-50/40 dark:bg-rose-950/20 border-rose-200 dark:border-rose-900/70{{else}}border-l-emerald-600 bg-slate-50/80 dark:bg-slate-800/50 border-slate-200 dark:border-slate-700{{/if}}{{/if}}{{/if}} space-y-1.5 text-xs transition-colors"
                  >
                    <div class="flex flex-wrap items-start justify-between gap-2">
                      <div class="flex flex-wrap items-center gap-1.5">
                        <span class="font-bold text-slate-900 dark:text-slate-100">{{this.name}}</span>
                        {{#if this.additiveCode}}
                          <span class="additive-pill">{{this.additiveCode}}</span>
                        {{/if}}
                        {{#if this.isAllergen}}
                          <span class="allergen-pill">Allergen: {{this.allergenType}}</span>
                        {{/if}}
                      </div>
                      <span class="text-[11px] font-bold px-2 py-0.5 rounded shrink-0 {{#if this.isWarning}}bg-rose-100 dark:bg-rose-950 text-rose-800 dark:text-rose-300{{else}}{{#if this.isCaution}}bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300{{else}}bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300{{/if}}{{/if}}">
                        {{#if this.isWarning}}Warning{{else}}{{#if this.isCaution}}Caution{{else}}Safe{{/if}}{{/if}}
                      </span>
                    </div>
                    <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed max-w-[75ch]">
                      {{this.explanation}}
                    </p>
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[10px] font-mono text-slate-500 dark:text-slate-400 pt-0.5">
                      <span>Source: <strong class="text-slate-700 dark:text-slate-300">{{this.ruleSource}}</strong></span>
                      <span>FDA: {{this.fdaStatus}}</span>
                      <span>EU: {{this.euStatus}}</span>
                    </div>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <div class="p-3 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-xs text-slate-500 dark:text-slate-400">
                None of the declared ingredients matched a verified entry in the active food rule base yet.
              </div>
            {{/if}}
          </div>

          <!-- PART B: Explicitly Separated Unknown / Unclassified Ingredients (Never Treated as Safe) -->
          {{#if ingredientAnalysis.hasUnknownIngredients}}
            <div class="p-4 rounded-xl border-2 border-dashed border-slate-400 dark:border-indigo-700/70 bg-slate-50/90 dark:bg-slate-900/90 space-y-3">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <span class="w-5 h-5 rounded bg-slate-800 dark:bg-indigo-700 text-white font-mono font-bold text-xs flex items-center justify-center shrink-0">?</span>
                  <h3 class="text-xs font-extrabold text-slate-900 dark:text-white">
                    Unclassified / unknown ingredients ({{ingredientAnalysis.unknownIngredients.length}}) — not assumed safe
                  </h3>
                </div>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-indigo-300 self-start sm:self-auto">
                  Pending rule review
                </span>
              </div>
              <p class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed">
                These declared items did not match an active regulatory entry in TrueLabel's food rule base. In accordance with safety standards, unclassified declarations are separated from safe ingredients and receive a transparency penalty until reviewed.
              </p>

              <div class="space-y-2">
                {{#each ingredientAnalysis.unknownIngredients}}
                  <div
                    data-inspectable-ingredient
                    data-ingredient-name="{{this.name}}{{#if this.additiveCode}} ({{this.additiveCode}}){{/if}}"
                    data-hazard="unknown"
                    data-hazard-detail="{{this.explanation}}"
                    data-fda-status="{{this.fdaStatus}}"
                    data-eu-status="{{this.euStatus}}"
                    data-rule-source="{{this.ruleSource}}"
                    data-allergen="{{#if this.isAllergen}}{{this.allergenType}}{{else}}false{{/if}}"
                    data-citation="TrueLabel F03 Unclassified Ingredient — {{this.name}}: {{this.explanation}}"
                    class="cursor-help p-3 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950/60 space-y-1 text-xs"
                  >
                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <div class="flex flex-wrap items-center gap-1.5">
                        <span class="font-bold text-slate-900 dark:text-slate-100">{{this.name}}</span>
                        {{#if this.additiveCode}}
                          <span class="additive-pill">{{this.additiveCode}}</span>
                        {{/if}}
                        {{#if this.isAllergen}}
                          <span class="allergen-pill">Allergen: {{this.allergenType}}</span>
                        {{/if}}
                      </div>
                      <span class="text-[11px] font-bold px-2 py-0.5 rounded bg-slate-200 dark:bg-slate-800 text-slate-800 dark:text-indigo-300">
                        Unclassified (Not safe)
                      </span>
                    </div>
                    <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-relaxed">
                      {{this.explanation}}
                    </p>
                  </div>
                {{/each}}
              </div>
            </div>
          {{/if}}

        {{else}}
          <div class="text-xs text-slate-400 italic p-3">No ingredients declared for this food product yet.</div>
        {{/if}}
      </section>

      <!-- Additives & Safety Info -->
      <div class="bg-white dark:bg-[#141413] border border-slate-200 dark:border-white/10 rounded-xl p-6 shadow-sm space-y-4">
        <h4 class="text-sm font-black text-slate-900 dark:text-slate-100 tracking-tight">Food safety &amp; compliance summary</h4>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
          <div class="p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
            <div class="text-slate-500 dark:text-slate-400 font-semibold text-[11px]">Additives detected</div>
            <div class="text-lg font-black font-mono text-slate-800 dark:text-slate-200 mt-0.5">{{additives.length}} identified</div>
          </div>
          <div class="p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
            <div class="text-slate-500 dark:text-slate-400 font-semibold text-[11px]">Allergen flags</div>
            <div class="text-lg font-black font-mono {{#if allergens.length}}text-rose-700 dark:text-rose-400{{else}}text-emerald-700 dark:text-emerald-400{{/if}} mt-0.5">
              {{allergens.length}} flagged
            </div>
          </div>
          <div class="p-3 bg-slate-50 dark:bg-slate-800/50 rounded-lg border border-slate-200 dark:border-slate-700">
            <div class="text-slate-500 dark:text-slate-400 font-semibold text-[11px]">Unclassified items</div>
            <div class="text-lg font-black font-mono {{#if ingredientAnalysis.hasUnknownIngredients}}text-indigo-700 dark:text-indigo-300{{else}}text-emerald-700 dark:text-emerald-400{{/if}} mt-0.5">
              {{#if ingredientAnalysis.counts}}{{ingredientAnalysis.counts.unknown}}{{else}}0{{/if}} unverified
            </div>
          </div>
        </div>

        <!-- Verified Accreditation Micro-Seals (A90 88x31-inspired) -->
        <div class="pt-3 border-t border-slate-100 dark:border-white/10 space-y-2">
          <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Accredited Safety Seals</div>
          <div class="flex flex-wrap gap-2">
            <span class="cert-seal-badge bg-emerald-50 dark:bg-emerald-950/50 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-700">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              ISO 22000
            </span>
            <span class="cert-seal-badge bg-blue-50 dark:bg-blue-950/50 text-blue-800 dark:text-blue-300 border-blue-300 dark:border-blue-700">
              <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
              BSTI CERTIFIED
            </span>
            <span class="cert-seal-badge bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-300 border-slate-300 dark:border-slate-600">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-600"></span>
              NON-GMO VERIFIED
            </span>
          </div>
        </div>

        <!-- Cryptographic Batch Imprint Visual Seal (A90 144px Imprint Canvas) -->
        <div class="pt-3 border-t border-slate-100 dark:border-white/10 flex items-center justify-between gap-3">
          <div class="space-y-0.5">
            <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Cryptographic Batch Seal</div>
            <div class="text-xs font-semibold text-slate-700 dark:text-slate-300">Lot Verification Hash: <code class="font-mono text-[11px]">{{product.barcode}}</code></div>
            <div class="text-[10px] text-slate-400 dark:text-slate-500">Deterministic 12x12 visual verification matrix</div>
          </div>
          <canvas
            class="batch-imprint-canvas shrink-0"
            data-batch-imprint
            data-a90-reticle
            data-batch-code="{{product.barcode}}"
            data-pixel-size="4"
            width="48"
            height="48"
            title="Deterministic Cryptographic Batch Hash"
          ></canvas>
        </div>

        <!-- Standard Informational Disclaimer (Proposal / PROJECT_RULES §5.3) -->
        <p class="pt-3 border-t border-slate-100 dark:border-white/10 text-[11px] text-slate-500 dark:text-slate-400 leading-relaxed">
          Informational notice: TrueLabel's rule-based ingredient breakdown and quality scores are provided for consumer education and transparency only. Always verify the physical product packaging before consumption, especially for severe allergies or medical conditions.
        </p>
      </div>

    </div>
  </div>
</div>

{{#if (eq user.role 'admin')}}
  <!-- Modal: Administrative Ban Food Product -->
  <div
    id="banProductModal"
    class="!m-0 fixed inset-0 z-[100] bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden"
    onclick="if (event.target === this) closeBanProductModal()"
  >
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-2xl max-w-lg w-full max-h-[90vh] flex flex-col border border-slate-200 dark:border-slate-700 overflow-hidden transform transition-all">
      <div class="p-4 sm:p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-rose-50/50 dark:bg-rose-950/30">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-rose-700 text-white flex items-center justify-center text-xs font-bold">!</span>
          <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Ban food product from website</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Statutory quarantine &amp; regulatory notice</p>
          </div>
        </div>
        <button
          type="button"
          onclick="closeBanProductModal()"
          class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg min-h-[44px] min-w-[44px] flex items-center justify-center"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <form method="POST" action="/catalog/manage/{{product.id}}/ban" class="p-4 sm:p-6 space-y-4 overflow-y-auto flex-grow">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
            Mandatory regulatory violation / ban reason <span class="text-rose-600">*</span>
          </label>
          <textarea
            name="reason"
            required
            rows="4"
            placeholder="Specify laboratory finding, undeclared allergen, toxic additive, counterfeit report reference, or statutory BFSA/FDA recall docket..."
            class="w-full text-xs rounded-lg border border-slate-300 dark:border-slate-700 p-3 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-700"
          ></textarea>
          <p class="text-[11px] text-slate-400 mt-1">Minimum 5 characters. This explanation will be displayed publicly on the product's safety advisory docket.</p>
        </div>

        <div class="pt-2 flex items-center justify-end gap-2.5">
          <button
            type="button"
            onclick="closeBanProductModal()"
            class="min-h-[44px] px-4 py-2 border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg text-xs font-semibold transition-colors"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="min-h-[44px] px-4 py-2 bg-rose-700 hover:bg-rose-800 text-white rounded-lg text-xs font-semibold transition-colors shadow-sm"
          >
            Confirm regulatory ban
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Administrative Permanent Deletion -->
  <div
    id="deleteProductModal"
    class="!m-0 fixed inset-0 z-[100] bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden"
    onclick="if (event.target === this) closeDeleteProductModal()"
  >
    <div class="bg-white dark:bg-slate-900 rounded-xl shadow-2xl max-w-lg w-full max-h-[90vh] flex flex-col border border-slate-200 dark:border-slate-700 overflow-hidden transform transition-all">
      <div class="p-4 sm:p-6 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between bg-rose-50/50 dark:bg-rose-950/30">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-rose-700 text-white flex items-center justify-center text-xs font-bold">&times;</span>
          <div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white">Permanently delete food formulation</h3>
            <p class="text-xs text-rose-600 font-semibold">Irreversible administrative wipe</p>
          </div>
        </div>
        <button
          type="button"
          onclick="closeDeleteProductModal()"
          class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg min-h-[44px] min-w-[44px] flex items-center justify-center"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <form method="POST" action="/catalog/manage/{{product.id}}/delete" class="p-4 sm:p-6 space-y-4 overflow-y-auto flex-grow">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
          You are about to permanently delete <strong>{{product.name}}</strong> (Barcode: <code class="font-mono bg-slate-100 dark:bg-slate-800 px-1 py-0.5 rounded text-slate-800 dark:text-slate-200">{{product.barcode}}</code>). This will delete all declared ingredients, nutrition facts, and associated records.
        </p>

        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
            Type the barcode <strong class="font-mono text-slate-900 dark:text-white">{{product.barcode}}</strong> to confirm:
          </label>
          <input
            type="text"
            id="confirmDeleteBarcode"
            oninput="document.getElementById('confirmDeleteBtn').disabled = (this.value.trim() !== '{{product.barcode}}')"
            placeholder="Enter barcode exactly"
            class="w-full text-xs rounded-lg border border-slate-300 dark:border-slate-700 px-3 py-2 bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-700 font-mono min-h-[44px]"
          />
        </div>

        <div class="pt-2 flex items-center justify-end gap-2.5">
          <button
            type="button"
            onclick="closeDeleteProductModal()"
            class="min-h-[44px] px-4 py-2 border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-lg text-xs font-semibold transition-colors"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="confirmDeleteBtn"
            disabled
            class="min-h-[44px] px-4 py-2 bg-rose-700 hover:bg-rose-800 disabled:opacity-40 disabled:cursor-not-allowed text-white rounded-lg text-xs font-semibold transition-colors shadow-sm"
          >
            Delete product permanently
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openBanProductModal() {
      document.getElementById('banProductModal').classList.remove('hidden');
    }
    function closeBanProductModal() {
      document.getElementById('banProductModal').classList.add('hidden');
    }
    function openDeleteProductModal() {
      document.getElementById('deleteProductModal').classList.remove('hidden');
    }
    function closeDeleteProductModal() {
      document.getElementById('deleteProductModal').classList.add('hidden');
    }
  </script>
{{/if}}
