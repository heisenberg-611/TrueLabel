<div class="space-y-6">

  <!-- Breadcrumb & Actions Bar -->
  <div class="flex items-center justify-between">
    <a href="/catalog" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
      Back to food catalog
    </a>
    <div class="flex items-center gap-3">
      {{#if isOwner}}
        <a href="/catalog/manage/{{product.id}}/edit" class="text-xs font-semibold px-3 py-1.5 rounded-md border border-slate-300 text-slate-700 hover:bg-slate-50 transition-colors">
          Edit food details
        </a>
      {{/if}}
      <span class="text-xs font-mono text-slate-400">Barcode: {{product.barcode}}</span>
    </div>
  </div>

  <!-- Main Product Header: Editorial Dossier Hero -->
  <div class="bg-white border border-slate-200 rounded-xl p-6 sm:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
    <div class="space-y-2">
      <div class="text-xs font-semibold text-slate-500">
        <span class="text-slate-900 font-bold">{{product.brand}}</span> &bull; <span>{{product.category}}</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">{{product.name}}</h1>
      {{#if product.description}}
        <p class="text-sm text-slate-600 max-w-2xl leading-relaxed">{{product.description}}</p>
      {{/if}}
      
      <!-- Dietary Tags -->
      {{#if product.dietaryTags.length}}
        <div class="flex flex-wrap gap-1.5 pt-1">
          {{#each product.dietaryTags}}
            <span class="text-xs font-semibold px-2.5 py-1 bg-slate-100 text-slate-700 rounded-md">
              {{this}}
            </span>
          {{/each}}
        </div>
      {{/if}}
    </div>

    <!-- Explainable Food Quality Score Seal -->
    <div class="flex flex-col items-center justify-center p-5 rounded-xl bg-slate-50 border border-slate-200 text-center min-w-[170px] self-stretch md:self-auto">
      <span class="text-xs font-medium text-slate-500">Quality score</span>
      <div class="text-4xl font-black mt-1 font-mono {{#if (gte product.qualityScore 80)}}text-emerald-800{{else}}{{#if (gte product.qualityScore 60)}}text-amber-800{{else}}text-rose-800{{/if}}{{/if}}">
        {{product.qualityScore}}<span class="text-base text-slate-400 font-normal font-sans">/100</span>
      </div>
      <div class="text-xs font-semibold mt-1 {{#if (gte product.qualityScore 80)}}text-emerald-800{{else}}{{#if (gte product.qualityScore 60)}}text-amber-800{{else}}text-rose-800{{/if}}{{/if}}">
        {{#if (gte product.qualityScore 80)}}Tier 1: High transparency{{else}}{{#if (gte product.qualityScore 60)}}Tier 2: Moderate quality{{else}}Tier 3: Elevated processing{{/if}}{{/if}}
      </div>
      <span class="text-[11px] text-slate-400 mt-0.5">Algorithm verified</span>
    </div>
  </div>

  <!-- FEATURE F16: Personalized Health & Allergen Conflict Engine (Consumers Only) -->
  {{#if (eq user.role 'consumer')}}
    {{#if conflictEvaluation.profileConfigured}}
      {{#if conflictEvaluation.hasAllergenConflict}}
        <div class="bg-rose-50 border-2 border-rose-600 rounded-xl p-5 space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-rose-600 text-white flex items-center justify-center font-bold text-xs">!</span>
              <h3 class="text-sm font-bold text-rose-950">Critical allergen conflict detected</h3>
            </div>
            <a href="/personal/profile" class="text-xs font-semibold text-rose-800 hover:text-rose-950 underline">Edit profile</a>
          </div>
          <p class="text-xs text-rose-900 leading-relaxed">
            This food product contains declared ingredients that conflict with your saved allergy profile:
          </p>
          <div class="space-y-1.5">
            {{#each conflictEvaluation.conflicts}}
              {{#if (eq this.category "allergen")}}
                <div class="p-2.5 rounded-lg bg-white border border-rose-300 text-xs flex items-start gap-2">
                  <span class="font-bold text-rose-700 text-[11px] px-1.5 py-0.5 bg-rose-100 rounded">Match</span>
                  <div>
                    <span class="font-bold text-rose-950">{{this.title}}</span>
                    <span class="block text-slate-700 text-[11px] mt-0.5">{{this.description}}</span>
                  </div>
                </div>
              {{/if}}
            {{/each}}
          </div>
        </div>
      {{/if}}

      {{#if conflictEvaluation.hasDietaryConflict}}
        <div class="bg-amber-50 border border-amber-300 rounded-xl p-4 space-y-2">
          <div class="flex items-center justify-between">
            <h4 class="text-xs font-bold text-amber-950">Dietary lifestyle conflict</h4>
            <a href="/personal/profile" class="text-xs font-semibold text-amber-800 hover:text-amber-950 underline">Edit profile</a>
          </div>
          {{#each conflictEvaluation.conflicts}}
            {{#if (eq this.category "dietary")}}
              <p class="text-xs text-amber-900">{{this.description}}</p>
            {{/if}}
          {{/each}}
        </div>
      {{/if}}

      {{#if conflictEvaluation.hasNutritionWarning}}
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-3.5 text-xs text-blue-900 flex items-start gap-2">
          <span class="text-blue-700 font-bold">Note:</span>
          <div>
            <span class="font-semibold">Nutritional target threshold:</span>
            {{#each conflictEvaluation.conflicts}}
              {{#if (eq this.category "nutrition")}}
                <span class="block text-[11px] text-blue-800 mt-0.5">{{this.description}}</span>
              {{/if}}
            {{/each}}
          </div>
        </div>
      {{/if}}

      {{#if conflictEvaluation.isSafeForUser}}
        <div class="bg-emerald-50 border border-emerald-300 rounded-xl p-4 flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 bg-emerald-700 text-white rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0">✓</div>
            <div>
              <h4 class="text-xs font-bold text-emerald-950">Clear for your dietary profile</h4>
              <p class="text-xs text-emerald-800 mt-0.5">
                No declared allergens or dietary restrictions from your profile ({{#each userProfile.allergies}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{#if userProfile.dietaryPreferences.length}} &bull; {{#each userProfile.dietaryPreferences}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}) were flagged in this product.
              </p>
            </div>
          </div>
          <a href="/personal/profile" class="text-xs font-semibold text-emerald-800 hover:text-emerald-950 underline flex-shrink-0">My profile</a>
        </div>
      {{/if}}

    {{else}}
      <!-- Profile Not Configured Callout -->
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <div class="text-xs font-bold text-slate-800">Personalize your allergen safety shield</div>
          <div class="text-xs text-slate-500 mt-0.5">Configure your allergy and dietary preferences to see real-time automated conflict warnings.</div>
        </div>
        <a href="/personal/profile" class="px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs rounded-lg text-center flex-shrink-0 transition-colors">
          Configure profile
        </a>
      </div>
    {{/if}}
  {{/if}}

  <!-- Allergen Warning Banner (If allergens declared) -->
  {{#if allergens.length}}
    <div class="bg-rose-50 border-2 border-rose-300 rounded-xl p-4 flex items-start gap-3">
      <div class="w-6 h-6 bg-rose-600 text-white rounded-full flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5">!</div>
      <div>
        <h4 class="text-sm font-bold text-rose-900">Declared allergen notice</h4>
        <p class="text-xs text-rose-800 mt-0.5">This food product contains declared allergens: 
          {{#each allergens}}
            <span class="font-semibold underline">{{this.name}} ({{this.allergenType}})</span>{{#unless @last}}, {{/unless}}
          {{/each}}.
        </p>
      </div>
    </div>
  {{/if}}

  <!-- Feature F11 & F13: Community Reviews Summary & Safety Reporting -->
  <section class="bg-white border border-slate-200 rounded-xl p-6 space-y-5">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-4">
      <div class="space-y-1">
        <h2 class="text-base font-bold text-slate-950">Consumer reviews and safety reports</h2>
        <p class="text-xs text-slate-500">
          Credibility-weighted ratings from verified accounts (independent of the lab-based Food Quality Score) and private safety reporting.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href="/community/products/{{product.id}}/reviews"
          class="px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-lg font-semibold text-xs transition-colors"
        >
          {{#if reviewSummary.reviewCount}}Read all {{reviewSummary.reviewCount}} reviews{{else}}Write the first review{{/if}}
        </a>
        {{#if (eq user.role 'consumer')}}
          <a
            href="/community/products/{{product.id}}/report"
            class="px-4 py-2 border border-rose-300 bg-rose-50 hover:bg-rose-100 text-rose-800 rounded-lg font-semibold text-xs transition-colors"
          >
            Report a product issue
          </a>
        {{/if}}
      </div>
    </div>

    {{#if reviewSummary.reviewCount}}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Aggregate & Dimension Summary -->
        <div class="lg:col-span-5 space-y-3">
          <div class="flex items-baseline gap-2">
            <span class="text-3xl font-black font-mono text-slate-950">{{reviewSummary.averageRating}}</span>
            <span class="text-xs font-mono text-slate-500">/ 5.0 weighted average ({{reviewSummary.reviewCount}} {{#if (eq reviewSummary.reviewCount 1)}}review{{else}}reviews{{/if}})</span>
          </div>
          <div class="grid grid-cols-2 gap-2.5 text-xs">
            {{#each reviewSummary.dimensionAverages}}
              <div class="bg-slate-50 border border-slate-100 rounded-md px-3 py-2">
                <span class="text-slate-500 block text-[11px]">{{this.label}}</span>
                <span class="font-mono font-bold text-slate-900">{{this.score}} / 5</span>
              </div>
            {{/each}}
          </div>
        </div>

        <!-- Recent Review Excerpts -->
        <div class="lg:col-span-7 divide-y divide-slate-100 border border-slate-100 rounded-lg bg-slate-50/50">
          {{#each reviewSummary.recentReviews}}
            <div class="p-4 space-y-1">
              <div class="flex items-center justify-between gap-2 text-xs">
                <span class="font-bold text-slate-900">{{this.authorName}} <span class="font-mono font-normal text-slate-500 ml-1">({{this.weightFormatted}})</span></span>
                <span class="font-mono font-bold text-emerald-800">{{this.rating}} / 5</span>
              </div>
              {{#if this.title}}
                <div class="text-xs font-semibold text-slate-800">{{this.title}}</div>
              {{/if}}
              <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">{{this.comment}}</p>
            </div>
          {{/each}}
        </div>
      </div>
    {{else}}
      <div class="text-xs text-slate-500">
        No consumer reviews recorded yet. Consumers can share structured ratings on taste, label accuracy, packaging condition, and purchase experience.
      </div>
    {{/if}}
  </section>

  <!-- Detailed Inspection: Nutrition Panel vs Ingredient Transparency -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- LEFT: FDA/EU Style Authentic Nutrition Facts Box (5 cols) -->
    <div class="lg:col-span-5 bg-white p-6 border border-slate-200 rounded-lg">
      <div class="nutrition-panel mx-auto">
        <h3>Nutrition Facts</h3>
        
        <div class="nutrition-serving-header">
          <div>Serving size: {{product.servingSize}}{{product.servingUnit}}</div>
          <div class="text-xs text-slate-500 font-normal">Amounts displayed per 100{{product.servingUnit}} / per serving</div>
        </div>

        <div class="nutrition-calories-row">
          <div>
            <div class="text-xs font-bold uppercase tracking-tight">Energy / Calories</div>
            <div class="text-xs text-slate-500 font-medium">Per 100{{product.servingUnit}}</div>
          </div>
          <div class="nutrition-calories-number font-mono">
            {{#each product.nutritionFacts}}
              {{#if (eq this.nutrient "Energy")}}{{this.amountPer100g}}{{/if}}
            {{/each}}
            <span class="text-sm font-bold font-sans">kcal</span>
          </div>
        </div>

        <!-- Nutrition Facts Breakdown Table -->
        <div class="space-y-0.5 text-xs">
          {{#each product.nutritionFacts}}
            {{#unless (eq this.nutrient "Energy")}}
              <div class="nutrition-row {{#if (or (eq this.nutrient 'Saturated Fat') (eq this.nutrient 'Sugars'))}}indent{{/if}}">
                <span class="{{#if (or (eq this.nutrient 'Fat') (eq this.nutrient 'Carbohydrates') (eq this.nutrient 'Protein') (eq this.nutrient 'Salt'))}}font-bold{{else}}text-slate-700{{/if}}">
                  {{this.nutrient}}
                </span>
                <span class="font-mono font-semibold">
                  {{this.amountPer100g}}{{this.unit}}
                </span>
              </div>
            {{/unless}}
          {{/each}}
        </div>

        <div class="mt-4 pt-2 border-t-2 border-slate-900 text-[10px] text-slate-500 leading-tight">
          * Nutrition records sourced directly from manufacturer declaration. Verified against standard food safety databases.
        </div>
      </div>
    </div>

    <!-- RIGHT: Declared Ingredients & Additives Breakdown (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      
      <!-- Ingredients Card -->
      <div class="bg-white border border-slate-200 rounded-lg p-6">
        <h3 class="text-base font-black text-slate-900 tracking-tight flex items-center justify-between">
          <span>Declared Ingredients</span>
          <span class="text-xs font-semibold text-slate-500 font-normal">{{product.ingredients.length}} items identified</span>
        </h3>
        <p class="text-xs text-slate-500 mt-1">Every declared ingredient is classified according to food rule databases for transparency.</p>

        <div class="mt-4 space-y-2">
          {{#if product.ingredients.length}}
            {{#each product.ingredients}}
              <div class="p-3 rounded border {{#if this.isAllergen}}bg-rose-50 border-rose-200{{else}}{{#if this.additiveCode}}bg-amber-50 border-amber-200{{else}}bg-slate-50 border-slate-200{{/if}}{{/if}} flex items-center justify-between text-xs">
                <div>
                  <span class="font-bold text-slate-900">{{this.name}}</span>
                  {{#if this.additiveCode}}
                    <span class="ml-2 additive-pill">Additive: {{this.additiveCode}}</span>
                  {{/if}}
                  {{#if this.isAllergen}}
                    <span class="ml-2 allergen-pill">Allergen: {{this.allergenType}}</span>
                  {{/if}}
                </div>
                <span class="text-[11px] font-bold uppercase {{#if (eq this.hazardLevel 'warning')}}text-rose-700{{else}}{{#if (eq this.hazardLevel 'caution')}}text-amber-700{{else}}text-emerald-700{{/if}}{{/if}}">
                  {{this.hazardLevel}}
                </span>
              </div>
            {{/each}}
          {{else}}
            <div class="text-xs text-slate-400 italic p-3">No ingredients declared for this food product yet.</div>
          {{/if}}
        </div>
      </div>

      <!-- Additives & Safety Info -->
      <div class="bg-white border border-slate-200 rounded-lg p-6">
        <h4 class="text-sm font-black text-slate-900 tracking-tight">Food Safety & Compliance Summary</h4>
        <div class="grid grid-cols-2 gap-4 mt-3 text-xs">
          <div class="p-3 bg-slate-50 rounded border border-slate-200">
            <div class="text-slate-400 font-bold uppercase text-[10px]">Additives Count</div>
            <div class="text-lg font-black text-slate-800 mt-0.5">{{additives.length}} identified</div>
          </div>
          <div class="p-3 bg-slate-50 rounded border border-slate-200">
            <div class="text-slate-400 font-bold uppercase text-[10px]">Allergen Flag Count</div>
            <div class="text-lg font-black {{#if allergens.length}}text-rose-700{{else}}text-emerald-700{{/if}} mt-0.5">
              {{allergens.length}} flagged
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

</div>

