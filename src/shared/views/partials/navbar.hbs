<header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-[0_1px_3px_rgba(15,23,42,0.03)]">
  <div class="container mx-auto px-4 max-w-7xl h-16 flex items-center justify-between gap-4">
    
    <!-- Left: Brand Logo & Primary Navigation -->
    <div class="flex items-center gap-7">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group text-decoration-none">
        <div class="w-9 h-9 bg-slate-900 text-white rounded-lg flex items-center justify-center font-black text-sm tracking-tighter group-hover:bg-emerald-700 transition-colors shadow-sm relative">
          TL
          <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-white"></span>
        </div>
        <div>
          <div class="font-extrabold text-slate-950 tracking-tight leading-none text-lg group-hover:text-emerald-700 transition-colors">TrueLabel</div>
          <div class="text-[10px] text-slate-500 font-semibold tracking-wider uppercase">Food Safety Standard</div>
        </div>
      </a>

      <!-- Desktop Primary Links -->
      <nav class="hidden lg:flex items-center gap-1 text-xs font-bold text-slate-600">
        <a href="/" class="px-3 py-2 rounded-md hover:text-slate-950 hover:bg-slate-100 transition-colors {{#if (eq activeNav 'home')}}text-emerald-700 bg-emerald-50/70 font-extrabold{{/if}}">
          Home
        </a>
        <a href="/catalog" class="px-3 py-2 rounded-md hover:text-slate-950 hover:bg-slate-100 transition-colors {{#if (eq activeNav 'catalog')}}text-emerald-700 bg-emerald-50/70 font-extrabold{{/if}}">
          Food Catalog
        </a>
        <a href="/safety/documents" class="px-3 py-2 rounded-md hover:text-slate-950 hover:bg-slate-100 transition-colors {{#if (eq activeNav 'documents')}}text-emerald-700 bg-emerald-50/70 font-extrabold{{/if}}">
          Safety Documents
        </a>
        <a href="/safety/licence/verify" class="px-3 py-2 rounded-md hover:text-slate-950 hover:bg-slate-100 transition-colors {{#if (eq activeNav 'verify')}}text-emerald-700 bg-emerald-50/70 font-extrabold{{/if}}">
          Verify Licence
        </a>

        {{#if user}}
          <a href="/dashboard" class="px-3 py-2 rounded-md hover:text-slate-950 hover:bg-slate-100 transition-colors {{#if (eq activeNav 'dashboard')}}text-emerald-700 bg-emerald-50/70 font-extrabold{{/if}}">
            Dashboard
          </a>
        {{/if}}

        <!-- Consumer Exclusive: Dietary Profile & Personal Safety Reports (F16 & F13) -->
        {{#if (eq user.role "consumer")}}
          <a href="/personal/profile" class="px-3 py-2 rounded-md hover:text-emerald-700 hover:bg-emerald-50 transition-colors flex items-center gap-1.5 {{#if (eq activeNav 'profile')}}text-emerald-700 bg-emerald-50 font-extrabold{{else}}text-slate-700{{/if}}">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
            Dietary Profile
          </a>
          <a href="/community/reports/mine" class="px-3 py-2 rounded-md hover:text-slate-950 hover:bg-slate-100 transition-colors {{#if (eq activeNav 'reports')}}text-emerald-700 bg-emerald-50/70 font-extrabold{{/if}}">
            My Reports
          </a>
        {{/if}}

        <!-- Inspector & Admin: Food Complaint Queue (F13) -->
        {{#if (or (eq user.role "inspector") (eq user.role "admin"))}}
          <a href="/community/reports/queue" class="px-3 py-2 rounded-md hover:text-slate-950 hover:bg-slate-100 transition-colors {{#if (eq activeNav 'complaints')}}text-emerald-700 bg-emerald-50/70 font-extrabold{{/if}}">
            Complaint Queue
          </a>
        {{/if}}
      </nav>
    </div>

    <!-- Right Controls: User Account & Theme Toggle -->
    <div class="hidden md:flex items-center gap-3">

      <!-- Authenticated User Profile Dropdown -->
      {{#if user}}
        <div class="relative" id="user-menu-wrapper">
          <button
            id="user-menu-button"
            type="button"
            class="flex items-center gap-2 p-1 pl-2 rounded-lg hover:bg-slate-100 border border-transparent hover:border-slate-200 transition-all focus:outline-none focus:ring-2 focus:ring-slate-900"
            aria-expanded="false"
          >
            <!-- Role-Colored User Initial -->
            <div class="w-8 h-8 rounded-full flex items-center justify-center font-black text-xs uppercase text-white shadow-sm {{#if (eq user.role 'consumer')}}bg-blue-600{{else}}{{#if (eq user.role 'manufacturer')}}bg-emerald-700{{else}}{{#if (eq user.role 'inspector')}}bg-amber-600{{else}}bg-slate-900{{/if}}{{/if}}{{/if}}">
              {{#if user.name}}{{user.name.[0]}}{{else}}U{{/if}}
            </div>

            <!-- Name and Role Pill -->
            <div class="text-left hidden lg:block">
              <div class="text-xs font-bold text-slate-900 leading-tight">{{user.name}}</div>
              <div class="text-[10px] uppercase font-bold tracking-wider {{#if (eq user.role 'consumer')}}text-blue-700{{else}}{{#if (eq user.role 'manufacturer')}}text-emerald-700{{else}}{{#if (eq user.role 'inspector')}}text-amber-700{{else}}text-slate-500{{/if}}{{/if}}{{/if}}">
                {{user.role}}
              </div>
            </div>

            <!-- Chevron -->
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>

          <!-- Dropdown Menu -->
          <div
            id="user-menu-dropdown"
            class="hidden absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-xl border border-slate-200 py-2 z-50 animate-fadeIn"
          >
            <!-- User Header -->
            <div class="px-4 py-3 border-b border-slate-100">
              <div class="text-xs font-extrabold text-slate-900">{{user.name}}</div>
              <div class="text-xs text-slate-500 font-mono mt-0.5 truncate">{{user.email}}</div>
              <div class="mt-2">
                <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider {{#if (eq user.role 'consumer')}}bg-blue-100 text-blue-800{{else}}{{#if (eq user.role 'manufacturer')}}bg-emerald-100 text-emerald-800{{else}}{{#if (eq user.role 'inspector')}}bg-amber-100 text-amber-800{{else}}bg-slate-100 text-slate-800{{/if}}{{/if}}{{/if}}">
                  Role: {{user.role}}
                </span>
              </div>
            </div>

            <!-- Role-Specific Shortcuts -->
            <div class="py-1 text-xs text-slate-700">
              <a href="/dashboard" class="flex items-center gap-2 px-4 py-2 hover:bg-slate-50 font-bold text-slate-900 border-b border-slate-100">
                <svg class="w-4 h-4 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                My Dashboard
              </a>

              {{#if (eq user.role "consumer")}}
                <a href="/personal/profile" class="flex items-center gap-2 px-4 py-2 hover:bg-slate-50 font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                  My Dietary & Allergen Profile
                </a>
                <a href="/community/reports/mine" class="flex items-center gap-2 px-4 py-2 hover:bg-slate-50 font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span>
                  My Reports
                </a>
              {{/if}}

              {{#if (or (eq user.role "manufacturer") (eq user.role "admin"))}}
                <a href="/catalog/manage/create" class="flex items-center gap-2 px-4 py-2 hover:bg-slate-50 font-medium">
                  <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                  Register New Food Product
                </a>
                <a href="/safety/documents/upload" class="flex items-center gap-2 px-4 py-2 hover:bg-slate-50 font-medium">
                  <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                  Upload Compliance Certificate
                </a>
              {{/if}}

              {{#if (or (eq user.role "inspector") (eq user.role "admin"))}}
                <a href="/safety/documents?status=pending" class="flex items-center gap-2 px-4 py-2 hover:bg-slate-50 font-medium text-amber-900">
                  <span class="w-2 h-2 rounded-full bg-amber-600"></span>
                  Pending Inspector Queue
                </a>
                <a href="/community/reports/queue" class="flex items-center gap-2 px-4 py-2 hover:bg-slate-50 font-medium text-rose-900">
                  <span class="w-2 h-2 rounded-full bg-rose-600"></span>
                  Complaint Queue
                </a>
              {{/if}}
            </div>

            <!-- Sign Out -->
            <div class="pt-1 border-t border-slate-100">
              <form action="/auth/logout" method="POST" class="w-full">
                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                <button type="submit" class="w-full text-left px-4 py-2 text-xs font-bold text-rose-700 hover:bg-rose-50 flex items-center justify-between">
                  <span>Sign Out</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                </button>
              </form>
            </div>
          </div>
        </div>
      {{else}}
        <!-- Guest Authentication Actions -->
        <div class="flex items-center gap-3">
          <a href="/auth/login" class="text-xs font-bold text-slate-700 hover:text-slate-950 transition-colors">
            Sign In
          </a>
          <a href="/auth/register" class="px-3.5 py-2 rounded-lg bg-slate-950 hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-wider transition-colors shadow-sm">
            Create Account
          </a>
        </div>
      {{/if}}

      <!-- Theme Mode Toggle (Desktop) -->
      <button
        id="theme-toggle-desktop"
        type="button"
        class="p-2 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-emerald-600 border border-slate-200"
        title="Toggle color theme (Light / Dark)"
        aria-label="Toggle color theme"
      >
        <!-- Sun icon (Active in Dark Mode) -->
        <svg id="theme-sun-desktop" class="w-4 h-4 hidden text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (Active in Light Mode) -->
        <svg id="theme-moon-desktop" class="w-4 h-4 block text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

    </div>

    <!-- Mobile Hamburger Toggle & Quick Theme Toggle -->
    <div class="flex items-center gap-2 lg:hidden">
      <!-- Quick Theme Toggle for Mobile Header -->
      <button
        id="theme-toggle-mobile-header"
        type="button"
        class="p-2 rounded-lg text-slate-700 hover:text-slate-950 hover:bg-slate-100 border border-slate-200 transition-colors"
        title="Toggle color theme"
        aria-label="Toggle color theme"
      >
        <svg id="theme-sun-mobile-header" class="w-4 h-4 hidden text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-moon-mobile-header" class="w-4 h-4 block text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <button
        id="mobile-nav-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        class="p-2 rounded-lg text-slate-700 hover:text-slate-950 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-900 transition-colors"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer / Dropdown Panel -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 py-4 space-y-4 shadow-xl animate-fadeIn">
    
    <!-- User Info if Authenticated -->
    {{#if user}}
      <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs uppercase text-white {{#if (eq user.role 'consumer')}}bg-blue-600{{else}}{{#if (eq user.role 'manufacturer')}}bg-emerald-700{{else}}{{#if (eq user.role 'inspector')}}bg-amber-600{{else}}bg-slate-900{{/if}}{{/if}}{{/if}}">
            {{#if user.name}}{{user.name.[0]}}{{else}}U{{/if}}
          </div>
          <div>
            <div class="text-xs font-bold text-slate-900">{{user.name}}</div>
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500">{{user.role}}</div>
          </div>
        </div>
        <form action="/auth/logout" method="POST">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">
          <button type="submit" class="text-xs font-bold px-2.5 py-1 rounded bg-white border border-slate-300 text-slate-700 hover:bg-slate-100">
            Sign Out
          </button>
        </form>
      </div>
    {{/if}}

    <!-- Mobile Navigation Links -->
    <div class="flex flex-col space-y-1 text-sm font-bold text-slate-700">
      <a href="/" class="px-3 py-2 rounded-md hover:bg-slate-100 hover:text-slate-950 flex items-center justify-between {{#if (eq activeNav 'home')}}text-emerald-700 bg-emerald-50/80 font-extrabold{{/if}}">
        <span>Home</span>
        <span class="text-xs text-slate-400">&rarr;</span>
      </a>
      <a href="/catalog" class="px-3 py-2 rounded-md hover:bg-slate-100 hover:text-slate-950 flex items-center justify-between {{#if (eq activeNav 'catalog')}}text-emerald-700 bg-emerald-50/80 font-extrabold{{/if}}">
        <span>Food Catalog Discovery</span>
        <span class="text-xs text-slate-400">&rarr;</span>
      </a>
      <a href="/safety/documents" class="px-3 py-2 rounded-md hover:bg-slate-100 hover:text-slate-950 flex items-center justify-between {{#if (eq activeNav 'documents')}}text-emerald-700 bg-emerald-50/80 font-extrabold{{/if}}">
        <span>Safety Documents Registry</span>
        <span class="text-xs text-slate-400">&rarr;</span>
      </a>
      <a href="/safety/licence/verify" class="px-3 py-2 rounded-md hover:bg-slate-100 hover:text-slate-950 flex items-center justify-between {{#if (eq activeNav 'verify')}}text-emerald-700 bg-emerald-50/80 font-extrabold{{/if}}">
        <span>Verify Manufacturer Licence</span>
        <span class="text-xs text-slate-400">&rarr;</span>
      </a>
      {{#if user}}
        <a href="/dashboard" class="px-3 py-2 rounded-md hover:bg-slate-100 hover:text-slate-950 flex items-center justify-between {{#if (eq activeNav 'dashboard')}}text-emerald-700 bg-emerald-50/80 font-extrabold{{/if}}">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            My Dashboard
          </span>
          <span class="text-xs text-slate-400">&rarr;</span>
        </a>
      {{/if}}
      {{#if (eq user.role "consumer")}}
        <a href="/personal/profile" class="px-3 py-2 rounded-md hover:bg-emerald-100 flex items-center justify-between {{#if (eq activeNav 'profile')}}text-emerald-800 bg-emerald-100 font-extrabold{{else}}bg-emerald-50 text-emerald-800{{/if}}">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
            My Dietary & Allergen Profile
          </span>
          <span class="text-xs text-emerald-600 font-bold">&rarr;</span>
        </a>
        <a href="/community/reports/mine" class="px-3 py-2 rounded-md hover:bg-slate-100 hover:text-slate-950 flex items-center justify-between">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-rose-600"></span>
            My Reports
          </span>
          <span class="text-xs text-slate-400">&rarr;</span>
        </a>
      {{/if}}
      {{#if (or (eq user.role "inspector") (eq user.role "admin"))}}
        <a href="/community/reports/queue" class="px-3 py-2 rounded-md hover:bg-slate-100 hover:text-slate-950 flex items-center justify-between">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-rose-600"></span>
            Complaint Queue
          </span>
          <span class="text-xs text-slate-400">&rarr;</span>
        </a>
      {{/if}}
    </div>

    <!-- Mobile Guest Actions -->
    {{#unless user}}
      <div class="pt-3 border-t border-slate-100 grid grid-cols-2 gap-2">
        <a href="/auth/login" class="text-center py-2.5 rounded-lg border border-slate-300 text-slate-800 font-bold text-xs">
          Sign In
        </a>
        <a href="/auth/register" class="text-center py-2.5 rounded-lg bg-slate-950 text-white font-bold text-xs uppercase tracking-wider">
          Create Account
        </a>
      </div>
    {{/unless}}

    <!-- Mobile Theme Switcher Row -->
    <div class="pt-3 border-t border-slate-200 flex items-center justify-between px-1">
      <div class="flex items-center gap-2 text-xs font-bold text-slate-700">
        <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
        <span>Color Theme</span>
      </div>
      <button
        id="theme-toggle-drawer"
        type="button"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 bg-slate-50 text-xs font-bold text-slate-700 hover:bg-slate-100 transition-colors"
      >
        <span id="theme-drawer-text">Switch Mode</span>
      </button>
    </div>

  </div>

  <!-- Vanilla JS Dropdown & Mobile Toggle Handlers -->
  <script>
    (function() {
      // 1. Mobile Menu Toggle
      const toggleBtn = document.getElementById('mobile-nav-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (toggleBtn && mobileMenu) {
        toggleBtn.addEventListener('click', function() {
          const isHidden = mobileMenu.classList.contains('hidden');
          if (isHidden) {
            mobileMenu.classList.remove('hidden');
            if (hamburgerIcon) hamburgerIcon.classList.add('hidden');
            if (closeIcon) closeIcon.classList.remove('hidden');
          } else {
            mobileMenu.classList.add('hidden');
            if (hamburgerIcon) hamburgerIcon.classList.remove('hidden');
            if (closeIcon) closeIcon.classList.add('hidden');
          }
        });
      }

      // 2. Desktop User Menu Dropdown Toggle
      const userBtn = document.getElementById('user-menu-button');
      const userDropdown = document.getElementById('user-menu-dropdown');

      if (userBtn && userDropdown) {
        userBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          const isHidden = userDropdown.classList.contains('hidden');
          if (isHidden) {
            userDropdown.classList.remove('hidden');
            userBtn.setAttribute('aria-expanded', 'true');
          } else {
            userDropdown.classList.add('hidden');
            userBtn.setAttribute('aria-expanded', 'false');
          }
        });

        // Close on outside click
        document.addEventListener('click', function(e) {
          if (!userDropdown.classList.contains('hidden') && !userDropdown.contains(e.target) && !userBtn.contains(e.target)) {
            userDropdown.classList.add('hidden');
            userBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // 3. Theme Toggle Handlers (Desktop & Mobile)
      function updateThemeUI() {
        const isDark = document.documentElement.classList.contains('dark');
        
        // Update desktop icons
        const sunDesktop = document.getElementById('theme-sun-desktop');
        const moonDesktop = document.getElementById('theme-moon-desktop');
        if (sunDesktop && moonDesktop) {
          if (isDark) {
            sunDesktop.classList.remove('hidden');
            moonDesktop.classList.add('hidden');
          } else {
            sunDesktop.classList.add('hidden');
            moonDesktop.classList.remove('hidden');
          }
        }

        // Update mobile header icons
        const sunMobileHeader = document.getElementById('theme-sun-mobile-header');
        const moonMobileHeader = document.getElementById('theme-moon-mobile-header');
        if (sunMobileHeader && moonMobileHeader) {
          if (isDark) {
            sunMobileHeader.classList.remove('hidden');
            moonMobileHeader.classList.add('hidden');
          } else {
            sunMobileHeader.classList.add('hidden');
            moonMobileHeader.classList.remove('hidden');
          }
        }

        // Update mobile drawer text
        const drawerText = document.getElementById('theme-drawer-text');
        if (drawerText) {
          drawerText.textContent = isDark ? '🌙 Dark Active (Switch)' : '☀️ Light Active (Switch)';
        }
      }

      function toggleTheme() {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('truelabel_theme', isDark ? 'dark' : 'light');
        } catch (e) {}
        updateThemeUI();
      }

      const btnDesktop = document.getElementById('theme-toggle-desktop');
      if (btnDesktop) btnDesktop.addEventListener('click', toggleTheme);

      const btnMobileHeader = document.getElementById('theme-toggle-mobile-header');
      if (btnMobileHeader) btnMobileHeader.addEventListener('click', toggleTheme);

      const btnDrawer = document.getElementById('theme-toggle-drawer');
      if (btnDrawer) btnDrawer.addEventListener('click', toggleTheme);

      // Initialize theme icons
      updateThemeUI();
    })();
  </script>
</header>
