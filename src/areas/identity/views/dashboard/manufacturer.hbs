<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
  <!-- Header: Enterprise Compliance Console -->
  <div class="bg-white border border-slate-200 rounded-xl p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700">
          Manufacturer console
        </span>
        {{#if hasApprovedDocument}}
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200">
            Compliance approved
          </span>
        {{else}}
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200">
            Accreditation pending
          </span>
        {{/if}}
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">{{user.name}}</h1>
      <p class="text-sm text-slate-500 max-w-2xl">
        Manage corporate compliance certificates, statutory trade licences, and your registered packaged food catalog.
      </p>
    </div>
    
    <div class="flex flex-wrap items-center gap-2.5">
      <a
        href="/catalog/manage/create"
        class="px-4 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-semibold transition-colors flex items-center gap-2 shadow-sm"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Register food product
      </a>
      <a
        href="/safety/documents/upload"
        class="px-4 py-2.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-semibold transition-colors flex items-center gap-2"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
        Upload certificate
      </a>
      <a
        href="/safety/licence/verify"
        class="px-4 py-2.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-semibold transition-colors"
      >
        Verify licence
      </a>
    </div>
  </div>

  <!-- Operational Overview: Split Docket -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Left: Statutory Licence Credentials (7 cols) -->
    <div class="lg:col-span-7 bg-white border border-slate-200 rounded-xl p-6 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div>
            <h2 class="text-sm font-bold text-slate-900">Corporate statutory licence</h2>
            <p class="text-xs text-slate-400">Government food safety authority accreditation record</p>
          </div>
          {{#if licence}}
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold {{#if (eq licence.status 'valid')}}bg-emerald-50 text-emerald-800 border border-emerald-200{{else}}bg-amber-50 text-amber-800 border border-amber-200{{/if}}">
              <span class="w-1.5 h-1.5 rounded-full {{#if (eq licence.status 'valid')}}bg-emerald-600{{else}}bg-amber-600{{/if}}"></span>
              {{licence.status}}
            </span>
          {{/if}}
        </div>

        {{#if licence}}
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-5 text-xs">
            <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
              <span class="text-slate-400 block mb-0.5">Licence number</span>
              <span class="font-mono font-bold text-slate-900 text-sm">{{licence.licenceNumber}}</span>
            </div>
            <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
              <span class="text-slate-400 block mb-0.5">Regulatory authority</span>
              <span class="font-semibold text-slate-800 text-sm">{{licence.authority}}</span>
            </div>
            <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
              <span class="text-slate-400 block mb-0.5">Registration date</span>
              <span class="font-mono text-slate-700">{{licence.issueDate}}</span>
            </div>
            <div class="p-3 bg-slate-50 rounded-lg border border-slate-100">
              <span class="text-slate-400 block mb-0.5">Expiry date</span>
              <span class="font-mono font-semibold {{#if licence.isExpiringSoon}}text-amber-700{{else}}text-slate-700{{/if}}">
                {{licence.expiryDate}}
              </span>
            </div>
          </div>
        {{else}}
          <div class="py-8 text-center text-slate-500">
            <p class="text-xs">No statutory licence linked to this enterprise account.</p>
            <a href="/safety/licence/verify" class="text-xs font-semibold text-emerald-700 hover:text-emerald-900 underline mt-2 inline-block">
              Verify licence now
            </a>
          </div>
        {{/if}}
      </div>

      <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
        <span class="text-slate-400">Statutory authority: BSTI / FDA Registered</span>
        <a href="/safety/licence/verify" class="font-semibold text-slate-700 hover:text-slate-900 underline">
          Check verification registry
        </a>
      </div>
    </div>

    <!-- Right: Accreditation Health & Catalog Volume (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <!-- Accreditations summary -->
      <div class="bg-white border border-slate-200 rounded-xl p-6">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <div>
            <h2 class="text-sm font-bold text-slate-900">Safety accreditations</h2>
            <p class="text-xs text-slate-400">{{documentStats.total}} documents submitted for audit</p>
          </div>
          <a href="/safety/documents" class="text-xs font-semibold text-slate-600 hover:text-slate-900 underline">
            View all
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3 mt-4 text-center">
          <div data-a90-cursor="shield" class="p-3 rounded-lg bg-emerald-50/70 dark:bg-emerald-950/40 border border-emerald-100 dark:border-emerald-800/60 transition-transform hover:scale-[1.02]">
            <div class="text-xl font-black text-emerald-900 dark:text-emerald-400 font-mono">{{documentStats.approved}}</div>
            <div class="text-[11px] font-medium text-emerald-700 dark:text-emerald-300 mt-0.5">Approved</div>
          </div>
          <div data-a90-cursor="shield" class="p-3 rounded-lg bg-amber-50/70 dark:bg-amber-950/40 border border-amber-100 dark:border-amber-800/60 transition-transform hover:scale-[1.02]">
            <div class="text-xl font-black text-amber-900 dark:text-amber-400 font-mono">{{documentStats.pending}}</div>
            <div class="text-[11px] font-medium text-amber-700 dark:text-amber-300 mt-0.5">Pending</div>
          </div>
          <div data-a90-cursor="shield" class="p-3 rounded-lg bg-rose-50/70 dark:bg-rose-950/40 border border-rose-100 dark:border-rose-800/60 transition-transform hover:scale-[1.02]">
            <div class="text-xl font-black text-rose-900 dark:text-rose-400 font-mono">{{documentStats.rejected}}</div>
            <div class="text-[11px] font-medium text-rose-700 dark:text-rose-300 mt-0.5">Rejected</div>
          </div>
        </div>
      </div>

      <!-- Catalog Scope summary -->
      <div class="bg-white border border-slate-200 rounded-xl p-6 flex items-center justify-between">
        <div>
          <span class="text-xs font-medium text-slate-400 block">Registered catalog scope</span>
          <span class="text-2xl font-black text-slate-900 font-mono">{{totalProducts}}</span>
          <span class="text-xs text-slate-500 block mt-0.5">Packaged foods in public catalog</span>
        </div>
        <a
          href="/catalog/manage/create"
          class="px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-xs font-semibold transition-colors"
        >
          Add food
        </a>
      </div>
    </div>
  </div>

  <!-- Registered Products Table -->
  <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
    <div class="p-6 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-slate-900">Registered food products</h2>
        <p class="text-xs text-slate-500 mt-0.5">Formulations, declared ingredients, and transparency scores</p>
      </div>
      <a
        href="/catalog/manage/create"
        class="self-start sm:self-auto px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-lg text-xs font-semibold transition-colors"
      >
        Add food product
      </a>
    </div>

    {{#if products.length}}
      <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] text-left text-xs">
          <thead class="bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold text-[11px]">
            <tr>
              <th class="px-6 py-3.5">Product and category</th>
              <th class="px-6 py-3.5">Barcode</th>
              <th class="px-6 py-3.5">Serving size</th>
              <th class="px-6 py-3.5">Transparency score</th>
              <th class="px-6 py-3.5">Status</th>
              <th class="px-6 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 font-normal">
            {{#each products}}
              <tr class="hover:bg-slate-50/60 transition-colors">
                <td class="px-6 py-4">
                  <div class="font-bold text-slate-900 text-sm">{{this.name}}</div>
                  <div class="text-slate-500 text-xs mt-0.5">{{this.brand}} · {{this.category}}</div>
                </td>
                <td class="px-6 py-4 font-mono text-slate-600">
                  {{this.barcode}}
                </td>
                <td class="px-6 py-4 text-slate-600 font-mono">
                  {{this.servingSize}}{{this.servingUnit}}
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-bold font-mono {{#if (gte this.qualityScore 80)}}bg-emerald-50 text-emerald-800 border border-emerald-200{{else}}{{#if (gte this.qualityScore 60)}}bg-amber-50 text-amber-800 border border-amber-200{{else}}bg-rose-50 text-rose-800 border border-rose-200{{/if}}{{/if}}">
                    {{this.qualityScore}} / 100
                  </span>
                </td>
                <td class="px-6 py-4">
                  <span class="inline-block px-2 py-0.5 rounded text-[11px] font-medium {{#if (eq this.status 'active')}}bg-emerald-50 text-emerald-800 border border-emerald-200{{else}}bg-slate-100 text-slate-600{{/if}}">
                    {{this.status}}
                  </span>
                </td>
                <td class="px-6 py-4 text-right space-x-3">
                  <a href="/catalog/product/{{this.id}}" class="text-slate-600 hover:text-slate-900 font-semibold underline">View</a>
                  <a href="/community/products/{{this.id}}/reviews" class="text-slate-700 hover:text-slate-950 font-semibold underline">Reviews</a>
                  <a href="/catalog/manage/{{this.id}}/edit" class="text-emerald-700 hover:text-emerald-900 font-semibold underline">Edit</a>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="p-12 text-center text-slate-500">
        <p class="font-bold text-sm text-slate-900">No food products registered yet</p>
        <p class="text-xs text-slate-500 max-w-sm mx-auto mt-1 mb-5">
          Submit your packaged food products with verified nutrition declarations and ingredient lists to compute their Transparency Score.
        </p>
        <a
          href="/catalog/manage/create"
          class="inline-block px-4 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-semibold transition-colors"
        >
          Register first product
        </a>
      </div>
    {{/if}}
  </div>

  <!-- Feature F11: Consumer Reviews on Your Products -->
  <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
    <div class="p-6 border-b border-slate-200 flex items-center justify-between gap-4">
      <div>
        <h2 class="text-base font-bold text-slate-900">Recent consumer reviews on your products (F11)</h2>
        <p class="text-xs text-slate-500 mt-0.5">Respond officially to customer questions about label accuracy, packaging, or taste</p>
      </div>
      <span class="text-xs font-mono font-semibold text-slate-500">{{totalProductReviews}} visible</span>
    </div>
    {{#if productReviews.length}}
      <div class="divide-y divide-slate-100">
        {{#each productReviews}}
          <div class="p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class="font-bold text-slate-900">{{this.productName}}</span>
                <span class="font-mono font-bold px-2 py-0.5 rounded bg-emerald-50 text-emerald-900 border border-emerald-200">{{this.rating}} / 5</span>
                <span class="text-slate-500">by {{this.authorName}} ({{this.weightFormatted}})</span>
              </div>
              <p class="text-slate-600 max-w-2xl">{{this.comment}}</p>
            </div>
            <a href="/community/products/{{this.productId}}/reviews" class="px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-md font-semibold flex-shrink-0 transition-colors">
              {{#if this.manufacturerReply}}Update reply{{else}}Reply to review{{/if}}
            </a>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="p-8 text-center text-xs text-slate-500">
        No consumer reviews have been posted on your registered products yet.
      </div>
    {{/if}}
  </div>
</div>
