<div class="max-w-md mx-auto my-12 bg-white p-8 border border-slate-200 rounded-lg shadow-sm">
  <div class="mb-6 text-center">
    <a href="/" class="inline-block mb-4" aria-label="TrueLabel Home">
      <img
        src="/images/logo.png"
        alt="TrueLabel — Food Quality, Safety & Diet"
        width="160"
        height="108"
        class="brand-logo-light h-20 w-auto mx-auto object-contain"
      />
      <img
        src="/images/logo-dark.png"
        alt="TrueLabel — Food Quality, Safety & Diet"
        width="160"
        height="108"
        class="brand-logo-dark h-20 w-auto mx-auto object-contain"
      />
    </a>
    <h1 class="text-2xl font-black text-slate-900 tracking-tight">Create Account</h1>
    <p class="text-sm text-slate-500 mt-1">Join TrueLabel as a Consumer or Food Manufacturer.</p>
  </div>

  <form action="/auth/register" method="POST" class="space-y-4">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    <div>
      <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Full name</label>
      <input
        type="text"
        id="name"
        name="name"
        value="{{name}}"
        required
        placeholder="Sarah Jenkins"
        class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent"
      />
    </div>

    <div>
      <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Email address</label>
      <input
        type="email"
        id="email"
        name="email"
        value="{{email}}"
        required
        placeholder="sarah@example.com"
        class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent"
      />
    </div>

    <div>
      <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        required
        minlength="6"
        placeholder="At least 6 characters"
        class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent"
      />
    </div>

    <div>
      <label for="role" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Account Role</label>
      <select
        id="role"
        name="role"
        required
        class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm font-medium bg-white focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition-all shadow-sm"
      >
        <option value="consumer">Consumer (Search, rate, preference profile, intake)</option>
        <option value="manufacturer">Food Manufacturer (Register & manage own products)</option>
      </select>
    </div>

    <button
      type="submit"
      class="w-full py-2.5 px-4 bg-emerald-700 text-white font-bold text-sm rounded hover:bg-emerald-800 transition-colors"
    >
      Register Account
    </button>
  </form>

  <div class="mt-6 pt-6 border-t border-slate-100 text-center text-xs text-slate-500">
    Already have an account?
    <a href="/auth/login" class="text-slate-900 font-bold hover:underline">Sign in</a>
  </div>
</div>

